---
import '../styles/global.css';
const s = (await import('../data/settings.json')).default;
const SITE = 'https://www.saralemaitre.com';
const CALENDLY_DISCOVERY = s.calendlyDiscovery || 'https://calendly.com/sara-lemaitre-herbalist';

const {
  title, description,
  ogImage = `${SITE}/images/og-default.jpg`,
  canonical = SITE,
  currentPage = '',
  ogType = 'website',
  lang = 'en',
} = Astro.props;

const navPages = lang === 'fr' ? [
  { id: 'story',       label: 'Mon parcours', href: '/fr/story'       },
  { id: 'therapies',   label: 'Thérapies',    href: '/fr/therapies'   },
  { id: 'pricing',     label: 'Tarifs',       href: '/fr/pricing'     },
  { id: 'consultancy', label: 'Conseil',      href: '/fr/consultancy' },
] : [
  { id: 'story',       label: 'My story',    href: '/story'       },
  { id: 'therapies',   label: 'Therapies',   href: '/therapies'   },
  { id: 'pricing',     label: 'Pricing',     href: '/pricing'     },
  { id: 'consultancy', label: 'Consultancy', href: '/consultancy' },
];

const bookHref = lang === 'fr'
  ? (currentPage === 'consultancy' ? '#contact' : currentPage === 'book' ? CALENDLY_DISCOVERY : '/fr/book')
  : (currentPage === 'consultancy' ? '#contact' : currentPage === 'book' ? CALENDLY_DISCOVERY : '/book');
const bookLabel = lang === 'fr'
  ? (currentPage === 'consultancy' ? 'Me contacter' : 'Prendre rendez-vous')
  : (currentPage === 'consultancy' ? 'Get in touch' : 'Book a consultation');
const bookTarget = bookHref.startsWith('http') ? '_blank' : undefined;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <meta name="author" content="Sara Lemaitre" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Sara Lemaitre Herbal Medicine & Naturopathy" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en-gb" href={canonical} />
  <link rel="alternate" hreflang="fr" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a href="#main-content" class="skip-nav">Skip to main content</a>

  <nav id="nav" role="navigation" aria-label="Main navigation">
    <a href={lang === 'fr' ? '/fr/' : '/'} class="nav-logo">Sara Lemaitre</a>
    <ul class="nav-links" id="nav-links">
      {navPages.map(p => (
        <li>
          <a href={p.href} aria-current={currentPage === p.id ? 'page' : undefined}>{p.label}</a>
        </li>
      ))}
    </ul>
    <a href={bookHref} class="nav-book" target={bookTarget} rel={bookTarget ? 'noopener noreferrer' : undefined}>{bookLabel}</a>
    {lang === 'fr'
      ? <a href={currentPage === 'index' ? '/' : `/${currentPage}`} class="lang-toggle" aria-label="Switch to English">EN</a>
      : <a href={currentPage === 'index' ? '/fr/' : `/fr/${currentPage}`} class="lang-toggle" aria-label="Passer en français">FR</a>
    }
    <button class="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="nav-links" onclick="toggleNav(this)">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <main id="main-content">
    <slot />
  </main>

  <footer>
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="logo">Sara Lemaitre</span>
        {lang === 'fr'
          ? <p>Herboriste clinique, naturopathe et ancienne athlète de haut niveau. Spécialisée en santé hormonale, endométriose, SOPK, fatigue chronique et récupération sportive. En ligne et en présentiel. Français &amp; anglais.</p>
          : <p>Clinical herbalist and naturopath. Specialising in hormonal health, endometriosis, PMOS, chronic fatigue, and performance recovery. Online and in person. English &amp; French.</p>
        }
        <div class="footer-memberships">
          <img src="/images/anp-logo.jpg" alt="ANP member" />
          <img src="/images/gnc-logo.jpg" alt="GNC member" />
        </div>
      </div>
      <div>
        <p class="footer-col-title">{lang === 'fr' ? 'La pratique' : 'Practice'}</p>
        <ul class="footer-links">
          {lang === 'fr' ? (
            <>
              <li><a href="/fr/story">Mon parcours</a></li>
              <li><a href="/fr/therapies">Thérapies</a></li>
              <li><a href="/fr/pricing">Tarifs</a></li>
              <li><a href="/fr/book">Prendre rendez-vous</a></li>
              <li><a href="/fr/faq/">FAQ</a></li>
            </>
          ) : (
            <>
              <li><a href="/story">My story</a></li>
              <li><a href="/therapies">Therapies</a></li>
              <li><a href="/pricing">Pricing</a></li>
              <li><a href="/book">Book a consultation</a></li>
              <li><a href="/faq/">FAQ</a></li>
            </>
          )}
        </ul>
      </div>
      <div>
        <p class="footer-col-title">{lang === 'fr' ? 'Spécialisations' : 'Specialisms'}</p>
        <ul class="footer-links">
          {lang === 'fr' ? (
            <>
              <li><a href="/fr/therapies#hormonal">Santé hormonale</a></li>
              <li><a href="/fr/therapies#athlete">Sportifs &amp; performance</a></li>
              <li><a href="/fr/therapies#ihm">Massage crânien indien</a></li>
              <li><a href="/fr/therapies#constitutional">Bilan constitutionnel</a></li>
            </>
          ) : (
            <>
              <li><a href="/therapies#hormonal">Hormonal health</a></li>
              <li><a href="/therapies#athlete">Athletes &amp; performance</a></li>
              <li><a href="/therapies#ihm">Indian head massage</a></li>
              <li><a href="/therapies#constitutional">Constitutional assessment</a></li>
            </>
          )}
        </ul>
      </div>
      <div>
        <p class="footer-col-title">{lang === 'fr' ? 'Nous rejoindre' : 'Connect'}</p>
        <ul class="footer-links">
          {s.instagramUrl && <li><a href={s.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram">Instagram</a></li>}
          {s.linkedinUrl && <li><a href={s.linkedinUrl} target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a></li>}
          <li><a href={'mailto:' + s.email}>{lang === 'fr' ? 'Me contacter' : 'Get in touch'}</a></li>
          <li><a href={s.calendlyDiscovery} target="_blank" rel="noopener">{lang === 'fr' ? 'Prendre rendez-vous' : 'Book a call'}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2025 Sara Lemaitre · Clinical Herbalist &amp; Naturopath · <a href={lang === 'fr' ? '/fr/legal' : '/legal'} style="color:rgba(247,243,238,.35);">{lang === 'fr' ? 'Mentions légales' : 'Privacy & terms'}</a> · UK registered &amp; insured practitioner</p>
      <p>{lang === 'fr' ? 'Consultations en français & anglais · En ligne & en présentiel' : 'Consultations in English & French · Online & in person'}</p>
    </div>
  </footer>

  <script>
    const nav = document.getElementById('nav');
    if (nav) window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 60));
    function toggleNav(btn) {
      const links = document.getElementById('nav-links');
      const exp = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!exp));
      btn.setAttribute('aria-label', exp ? 'Open navigation menu' : 'Close navigation menu');
      links?.classList.toggle('open', !exp);
    }
    document.addEventListener('click', (e) => {
      const links = document.getElementById('nav-links');
      const btn = document.querySelector('.hamburger');
      if (links && btn && !links.contains(e.target) && !btn.contains(e.target)) {
        links.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
    const reveals = document.querySelectorAll('.reveal');
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.07, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(r => obs.observe(r));
  </script>
</body>
</html>

