  </svg>`
};
---
<BaseLayout {...meta}>
<style>
.consult-hero {
  padding: 10rem 5rem 7rem;
  background: var(--charcoal);
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 6rem;
  align-items: center;
}
.consult-hero-text .eyebrow { color: var(--sage-mid); margin-bottom: 1.5rem; }
.consult-hero-text h1 {
  font-size: clamp(2.2rem, 4.5vw, 3.5rem);
  color: var(--warm-white);
  line-height: 1.1;
  margin-bottom: 1.5rem;
}
.consult-hero-text h1 em { color: var(--sage-light); }
.consult-hero-text p { color: rgba(247,243,238,.55); line-height: 1.9; margin-bottom: 1.5rem; }
.consult-hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
.btn-p {
  display: inline-block; padding: .9rem 2rem;
  background: var(--bark); color: var(--warm-white);
  font-size: .8125rem; letter-spacing: .14em; text-transform: uppercase;
  transition: background .22s;
}
.btn-p:hover { background: var(--bark-light); }
.btn-g {
  display: inline-block; padding: .9rem 2rem;
  border: 1px solid rgba(247,243,238,.25); color: rgba(247,243,238,.65);
  font-size: .8125rem; letter-spacing: .14em; text-transform: uppercase;
  transition: all .22s;
}
.btn-g:hover { border-color: rgba(247,243,238,.6); color: rgba(247,243,238,.9); }
.consult-hero-photo { aspect-ratio: 3/4; overflow: hidden; }
.consult-hero-photo img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.75) saturate(.8); }

.stats-bar {
  background: var(--bark); padding: 2rem 5rem;
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem;
}
.stat-value { font-family: var(--font-serif); font-size: 1.5rem; color: var(--warm-white); font-style: italic; margin-bottom: .3rem; }
.stat-desc { font-size: .8rem; color: rgba(247,243,238,.45); line-height: 1.5; }

.who-for { padding: 7rem 5rem; background: var(--cream); }
.who-for-header { max-width: 640px; margin-bottom: 3.5rem; }
.who-for-header h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); margin-bottom: 1rem; }
.who-for-header p { color: var(--muted); line-height: 1.85; }

.client-types {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 2px;
}
.client-type {
  background: var(--warm-white);
  padding: 2.5rem 1.75rem;
  transition: background .3s;
  display: flex; flex-direction: column; align-items: flex-start;
}
.client-type:hover { background: var(--sage-pale); }
.client-icon { width: 68px; height: 68px; margin-bottom: 1.5rem; flex-shrink: 0; }
.client-type h3 { font-family: var(--font-serif); font-size: 1.1rem; margin-bottom: .5rem; line-height: 1.3; }
.client-type p { font-size: .875rem; color: var(--muted); line-height: 1.7; margin-bottom: .5rem; flex: 1; }
.client-type-sub { font-size: .75rem; color: var(--sage-mid); }

.services { padding: 7rem 5rem; background: var(--warm-white); }
.service-row {
  display: grid; grid-template-columns: 200px 1fr;
  gap: 4rem; padding: 4rem 0;
  border-top: 1px solid rgba(122,108,100,.1);
  align-items: start;
}
.service-aside-num {
  font-family: var(--font-serif); font-size: 3.5rem;
  color: var(--sage-light); font-style: italic;
  line-height: 1; margin-bottom: .5rem; opacity: .5;
}
.service-aside-tag {
  font-size: .7rem; letter-spacing: .14em;
  text-transform: uppercase; color: var(--sage-text); line-height: 1.6;
}
.service-title {
  font-family: var(--font-serif); font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  color: var(--charcoal); margin-bottom: 1rem;
}
.service-desc { color: var(--muted); line-height: 1.85; margin-bottom: 2rem; }
.service-deliverables-label {
  font-size: .7rem; letter-spacing: .18em;
  text-transform: uppercase; color: var(--sage-text); margin-bottom: 1rem;
}
.service-deliverables { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 2rem; }
.service-deliverables span {
  font-size: .8125rem; color: var(--muted);
  padding: .35rem .9rem; border: 1px solid var(--sage-light); background: var(--cream);
}
.service-enquire {
  display: inline-block; padding: .85rem 2rem;
  border: 1px solid var(--bark); color: var(--bark);
  font-size: .8125rem; letter-spacing: .14em; text-transform: uppercase;
  transition: all .22s;
}
.service-enquire:hover { background: var(--bark); color: var(--warm-white); }

.contact-section {
  padding: 7rem 5rem; background: var(--charcoal); text-align: center;
}
.contact-section h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); color: var(--warm-white); margin-bottom: 1rem; }
.contact-section p { color: rgba(247,243,238,.5); margin-bottom: 2.5rem; max-width: 500px; margin-left: auto; margin-right: auto; }
.contact-section a {
  display: inline-block; padding: 1.1rem 3rem;
  background: var(--sage-dark); color: var(--cream);
  font-size: .875rem; letter-spacing: .18em; text-transform: uppercase;
  transition: background .22s;
}
.contact-section a:hover { background: var(--sage-text); }

@media (max-width: 1200px) { .client-types { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 1024px) {
  .consult-hero { grid-template-columns: 1fr; gap: 3rem; padding: 8rem 2.5rem 4rem; }
  .consult-hero-photo { aspect-ratio: 16/9; }
  .stats-bar { grid-template-columns: 1fr 1fr; padding: 2rem 2.5rem; }
  .who-for, .services, .contact-section { padding: 5rem 2.5rem; }
  .service-row { grid-template-columns: 1fr; gap: 1.5rem; }
}
@media (max-width: 640px) {
  .client-types { grid-template-columns: 1fr 1fr; }
  .stats-bar { grid-template-columns: 1fr; }
}
</style>

<section class="consult-hero">
  <div class="consult-hero-text reveal">
    <p class="eyebrow">B2B · Organisations · Wellness brands</p>
    <h1>Wellness consultancy with <em>clinical depth</em></h1>
    <p>{d.heroDesc}</p>
    <div class="consult-hero-ctas">
      <a href="#services" class="btn-p">See what I offer</a>
      <a href="#contact" class="btn-g">Get in touch directly</a>
    </div>
  </div>
  <div class="reveal reveal-delay-1">
    {d.heroPhoto && d.heroPhoto !== '/images/sara-professional.jpg' && (
      <div class="consult-hero-photo">
        <img src={d.heroPhoto} alt="Sara Lemaitre" loading="eager" />
      </div>
    )}
  </div>
</section>

<div class="stats-bar">
  <div class="stat-item">
    <p class="stat-value">3</p>
    <p class="stat-desc">Herbal traditions — Western, TCM, Ayurveda</p>
  </div>
  <div class="stat-item">
    <p class="stat-value">EN/FR</p>
    <p class="stat-desc">Bilingual — English and French, UK and international</p>
  </div>
  <div class="stat-item">
    <p class="stat-value">B2B</p>
    <p class="stat-desc">Corporate wellness, brand advisory, product development</p>
  </div>
  <div class="stat-item">
    <p class="stat-value">Elite</p>
    <p class="stat-desc">National-level athlete background — sports clients welcome</p>
  </div>
</div>

<section class="who-for reveal">
  <div class="who-for-header">
    <h2>{d.whyTitle}</h2>
    <p>{d.whyDesc1}</p>
  </div>
  <div class="client-types">
    {d.clientTypes.map((ct, i) => (
      <div class={`client-type reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
        <div class="client-icon" set:html={icons[ct.id] || icons.corporate}></div>
        <h3>{ct.title}</h3>
        <p>{ct.desc}</p>
        <p class="client-type-sub">{ct.subtitle}</p>
      </div>
    ))}
  </div>
</section>

<section class="services" id="services">
  {d.services.map((service, i) => (
    <div class={`service-row reveal${i > 0 ? ' reveal-delay-1' : ''}`}>
      <div class="service-aside">
        <div class="service-aside-num">{service.number}</div>
        <div class="service-aside-tag">{service.tag}</div>
      </div>
      <div class="service-body">
        <h2 class="service-title">{service.title}</h2>
        <p class="service-desc">{service.desc}</p>
        <p class="service-deliverables-label">What's included</p>
        <div class="service-deliverables">
          {service.bullets.map(b => <span>{b}</span>)}
        </div>
        <a href="#contact" class="service-enquire">Get in touch to discuss options and pricing</a>
      </div>
    </div>
  ))}
</section>

<section class="contact-section" id="contact">
  <h2 class="reveal">{d.contactTitle}</h2>
  <p class="reveal">{d.contactDesc}</p>
  <a href={`mailto:${s.email}?subject=Consultancy enquiry`} class="reveal">Send an enquiry</a>
</section>


