    <line x1="34" y1="40" x2="26" y2="34" stroke="rgba(196,208,186,0.4)" stroke-width="0.7" stroke-linecap="round"/>
  </svg>`,
  sports: `<svg viewBox="0 0 68 68" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="34" cy="34" r="32" stroke="rgba(196,208,186,0.28)" stroke-width="0.65" stroke-dasharray="2.5 3.5" stroke-linecap="round"/>
    <circle cx="34" cy="34" r="20" stroke="rgba(196,208,186,0.82)" stroke-width="0.9" stroke-linecap="round"/>
    <circle cx="34" cy="34" r="10" stroke="rgba(196,208,186,0.82)" stroke-width="0.9" stroke-linecap="round"/>
    <circle cx="34" cy="34" r="2.5" fill="rgba(196,208,186,0.82)"/>
