---
import BaseLayout from '../layouts/BaseLayout.astro';
const d = (await import('../data/pricing.json')).default;
const s = (await import('../data/settings.json')).default;
const meta = {
  title: 'Pricing | Sara Lemaitre — Clinical Herbalist & Naturopath',
  description: 'Transparent pricing for herbal medicine and naturopathy consultations. Sliding scale available. Free discovery call.',
  canonical: 'https://www.saralemaitre.com/pricing',
  currentPage: 'pricing',
};
---
<BaseLayout {...meta}>
<style>
.pricing-hero {
  padding: 10rem 5rem 7rem;
  background: #3D3229;
}
.pricing-hero .eyebrow { color: var(--sage-mid); margin-bottom: 1rem; }
.pricing-hero h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--warm-white); line-height: 1.1; margin-bottom: 2rem;
}
.pricing-hero h1 em { color: var(--sage-light); }

.pricing-note {
  padding: 6rem 5rem;
  background: var(--cream);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
}
.pricing-note-text h2 {
  font-size: clamp(1.4rem, 2.5vw, 1.9rem); margin-bottom: 1.5rem;
}
.pricing-note-text p { color: var(--muted); line-height: 1.9; margin-bottom: 1rem; }
.commitment-box {
  background: var(--warm-white); padding: 2.5rem;
  border-top: 2px solid var(--sage-light);
}
.commitment-box h3 {
  font-family: var(--font-serif); font-size: 1.25rem;
  margin-bottom: 1.5rem; color: var(--charcoal);
}
.commitment-box p { font-size: .9375rem; color: var(--muted); line-height: 1.85; margin-bottom: 1rem; }

.payment-section {
  padding: 5rem;
  background: var(--warm-white);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
}
.payment-section h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 2rem; }
.payment-section > div > p { color: var(--muted); line-height: 1.9; margin-bottom: 1rem; }
.payment-steps {
  list-style: none; counter-reset: steps;
  margin: 1.5rem 0; display: flex; flex-direction: column; gap: 1rem;
}
.payment-steps li {
  counter-increment: steps;
  display: flex; gap: 1.5rem; align-items: baseline;
  font-size: .9375rem; color: var(--muted);
}
.payment-steps li::before {
  content: counter(steps);
  font-family: var(--font-serif); font-size: 1.25rem;
  font-style: italic; color: var(--sage-light);
  flex-shrink: 0; width: 1.5rem;
}
.bank-box {
  background: var(--cream); padding: 2rem;
  border: 1px solid var(--sage-light);
  margin-top: 1.5rem;
}
.bank-box h3 {
  font-family: var(--font-serif); font-size: 1.1rem;
  margin-bottom: 1rem; color: var(--charcoal);
}
.bank-row {
  display: grid; grid-template-columns: auto 1fr;
  gap: .4rem 2rem; margin-bottom: .5rem;
}
.bank-lbl { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--sage-text); }
.bank-val { font-size: .9375rem; color: var(--charcoal); }
.good-to-know {
  margin-top: 1.5rem; list-style: none;
  display: flex; flex-direction: column; gap: .75rem;
}
.good-to-know li {
  font-size: .875rem; color: var(--muted);
  padding-left: 1.5rem; position: relative; line-height: 1.7;
}
.good-to-know li::before { content: '—'; position: absolute; left: 0; color: var(--sage-light); }

.cancel-section { padding: 5rem; background: var(--cream); }
.cancel-section h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 3rem; }
.cancel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 1.5rem; }
.cancel-card { padding: 2rem; background: var(--warm-white); border-top: 2px solid var(--sage-light); }
.cancel-card h3 { font-family: var(--font-serif); font-size: 1.1rem; margin-bottom: .75rem; }
.cancel-card p { font-size: .9rem; color: var(--muted); line-height: 1.75; }
.cancel-note { font-family: var(--font-serif); font-style: italic; color: var(--muted); }

.faq-section { padding: 5rem; background: var(--warm-white); }
.faq-section h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 3rem; }
.faq-item { border-top: 1px solid var(--sage-light); padding: 1.5rem 0; }
.faq-item:last-child { border-bottom: 1px solid var(--sage-light); }
.faq-q { font-family: var(--font-serif); font-size: 1.1rem; color: var(--charcoal); margin-bottom: .75rem; }
.faq-a { font-size: .9375rem; color: var(--muted); line-height: 1.85; }

.pricing-cta { padding: 8rem 5rem; background: var(--bark); text-align: center; }
.pricing-cta h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); color: var(--warm-white); margin-bottom: 1rem; }
.pricing-cta p { color: rgba(247,243,238,.6); margin-bottom: 2.5rem; }
.pricing-cta .cta-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.btn-ep {
  display: inline-block; padding: 1rem 2.5rem;
  background: var(--sage-pale); color: #3D3229;
  font-size: .875rem; letter-spacing: .16em; text-transform: uppercase;
  transition: background .22s; font-weight: 500;
}
.btn-ep:hover { background: var(--sage-light); }
.btn-eg {
  display: inline-block; padding: 1rem 2.5rem;
  border: 1px solid rgba(247,243,238,.3); color: rgba(247,243,238,.8);
  font-size: .875rem; letter-spacing: .16em; text-transform: uppercase;
  transition: all .22s;
}
.btn-eg:hover { border-color: rgba(247,243,238,.7); color: white; }

@media (max-width: 1024px) {
  .pricing-hero, .cancel-section, .faq-section, .pricing-cta { padding: 5rem 2.5rem; }
  .pricing-note, .payment-section { grid-template-columns: 1fr; gap: 2rem; padding: 4rem 2.5rem; }
  .cancel-grid { grid-template-columns: 1fr; }
}
</style>

<section class="pricing-hero">
  <p class="eyebrow">Transparent pricing · No surprises</p>
  <h1>Investment in your <em>health</em></h1>
</section>

<section class="pricing-note reveal">
  <div class="pricing-note-text">
    <h2>A note on pricing and what it represents</h2>
    {d.pricingNote.split('\n\n').map(p => <p>{p}</p>)}
  </div>
  <div class="commitment-box">
    <h3>{d.commitmentTitle}</h3>
    <p>{d.commitment1}</p>
    <p>{d.commitment2}</p>
  </div>
</section>

<section class="payment-section reveal">
  <div>
    <h2>Payment by bank transfer</h2>
    <p>I accept payment by UK bank transfer — straightforward, secure, and fee-free for both of us.</p>
    <ol class="payment-steps">
      <li>Book your appointment using the booking options on the consultation page.</li>
      <li>You will receive a confirmation email with bank transfer details.</li>
      <li>Transfer the consultation fee within 24 hours of booking.</li>
      <li>Your appointment is confirmed once payment is received — you will get a final confirmation email.</li>
    </ol>
  </div>
  <div>
    <div class="bank-box">
      <h3>Good to know</h3>
      <ul class="good-to-know">
        <li>Bank transfer is completely free — no processing fees for you or for me.</li>
        <li>Transfers typically clear within a few hours for the same bank, or by the next working day.</li>
        <li>Please use your name and appointment date as the payment reference so I can match it easily.</li>
        <li>If you have any difficulty with bank transfer, get in touch and we can find an alternative arrangement.</li>
      </ul>
    </div>
  </div>
</section>

<section class="cancel-section reveal">
  <h2>Cancellation policy</h2>
  <div class="cancel-grid">
    {d.cancellationTiers.map(tier => (
      <div class="cancel-card">
        <h3>{tier.title}</h3>
        <p>{tier.policy}</p>
      </div>
    ))}
  </div>
  <p class="cancel-note">{d.cancellationNote}</p>
</section>


<section style="padding: 3rem 5rem; background: var(--sage-pale); text-align: center;">
  <p style="font-family: var(--font-serif); font-size: 1.125rem; color: var(--sage-text); margin-bottom: 1rem;">Have more questions before committing?</p>
  <a href="/faq" style="font-size: .8125rem; letter-spacing: .16em; text-transform: uppercase; color: var(--bark); border-bottom: 1px solid var(--bark); padding-bottom: .15rem;">Read the FAQ →</a>
</section>

<section class="pricing-cta">
  <h2 class="reveal">The first step costs nothing</h2>
  <p class="reveal">Fifteen minutes. No pressure, no commitment. Just an honest conversation about where you are and whether I can help.</p>
  <div class="cta-group reveal">
    <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="btn-ep">Book your free discovery call</a>
    <a href="/book" class="btn-eg">View consultation options</a>
  </div>
</section>
