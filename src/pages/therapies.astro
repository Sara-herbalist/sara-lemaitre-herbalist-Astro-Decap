---
<BaseLayout {...meta}>
<style>
.th-hero {
  background: #3D3229;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  gap: 0;
  min-height: 100vh;
}
.th-hero-text {
  padding: 10rem 5rem 7rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.th-hero-logo {
  background: var(--sage-pale);
  display: flex;
  align-items: center;
  justify-content: center;
}
.th-hero-logo svg { width: min(380px, 80%); height: auto; }
.th-hero .eyebrow { color: var(--sage-mid); margin-bottom: 1.5rem; }
.th-hero h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--warm-white);
  line-height: 1.1;
  margin-bottom: 2rem;
}
.th-hero-intro {
  color: rgba(247,243,238,.55);
  line-height: 1.9;
  margin-bottom: 1rem;
  font-size: 1.0625rem;
  max-width: 640px;
}
.therapy-block {
  padding: 7rem 5rem;
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 6rem;
  align-items: start;
  border-bottom: 1px solid rgba(122,108,100,.08);
}
.therapy-block:nth-child(odd) { background: var(--warm-white); }
.therapy-block:nth-child(even) { background: var(--cream); }
.therapy-icon { width: 68px; height: 68px; margin-bottom: 1.5rem; }
.therapy-label {
  font-size: .75rem; letter-spacing: .22em;
  text-transform: uppercase; color: var(--sage-text); margin-bottom: .75rem;
}
.therapy-block h2 {
  font-size: clamp(1.6rem, 2.5vw, 2.2rem);
  color: var(--charcoal); line-height: 1.2; margin-bottom: 1.5rem;
}
.therapy-details { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 2rem; }
.therapy-detail { display: flex; gap: 1rem; align-items: baseline; }
.detail-label {
  font-size: .75rem; letter-spacing: .14em;
  text-transform: uppercase; color: var(--sage-text);
  min-width: 68px; flex-shrink: 0;
}
.detail-value { font-size: 1rem; color: var(--muted); }
.therapy-photo { margin-bottom: 1.5rem; aspect-ratio: 4/3; overflow: hidden; }
.therapy-photo img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.87) saturate(.85); }
.btn-enquire {
  display: inline-block; padding: .85rem 2rem;
  border: 1px solid var(--bark); color: var(--bark);
  font-size: .9375rem; letter-spacing: .14em; text-transform: uppercase;
  transition: all .22s;
}
.btn-enquire:hover { background: var(--bark); color: var(--warm-white); }
.therapy-content p { color: var(--muted); line-height: 1.95; margin-bottom: 1.4rem; font-size: 1.0375rem; }
.th-cta { padding: 8rem 5rem; background: var(--sage-dark); text-align: center; }
.th-cta h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); color: var(--cream); margin-bottom: 1rem; }
.th-cta p { color: rgba(247,243,238,.6); margin-bottom: 2.5rem; max-width: 500px; margin-left: auto; margin-right: auto; font-size: 1rem; }
.th-cta a {
  display: inline-block; padding: 1.1rem 3rem;
  background: var(--bark); color: var(--cream);
  font-size: .9375rem; letter-spacing: .18em; text-transform: uppercase;
  transition: background .22s;
}
.th-cta a:hover { background: var(--bark-light); }
@media (max-width: 1024px) {
  .th-hero { grid-template-columns: 1fr; min-height: auto; }
  .th-hero-text { padding: 8rem 2.5rem 4rem; }
  .th-hero-logo { min-height: 60vw; }
  .therapy-block {
    grid-template-columns: 1fr; gap: 3rem; padding: 5rem 2.5rem;
  }
  .th-cta { padding: 5rem 2.5rem; }
}
</style>

<section class="th-hero">
  <div class="th-hero-text">
    <p class="eyebrow">The therapies</p>
    <h1>{d.pageTitle}</h1>
    {d.pageDesc.split('\n\n').map(p => <p class="th-hero-intro">{p}</p>)}
  </div>
  <div class="th-hero-logo">
    <svg viewBox="0 0 420 420" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="210" cy="210" r="200" fill="none" stroke="#9BAE8E" stroke-width="1.1" stroke-dasharray="5 9" opacity="0.45"/>
      <circle cx="210" cy="210" r="164" fill="none" stroke="#9BAE8E" stroke-width="0.9" stroke-dasharray="4 7" opacity="0.35"/>
      <circle cx="210" cy="210" r="126" fill="none" stroke="#7A8C6E" stroke-width="1.2"/>
      <path d="M210 84 C238 132 238 172 210 210 C182 172 182 132 210 84" fill="rgba(196,208,186,0.28)" stroke="#5C7A52" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M210 336 C182 288 182 248 210 210 C238 248 238 288 210 336" fill="rgba(196,208,186,0.28)" stroke="#5C7A52" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M84 210 C132 182 172 182 210 210 C172 238 132 238 84 210" fill="rgba(196,208,186,0.28)" stroke="#5C7A52" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M336 210 C288 238 248 238 210 210 C248 182 288 182 336 210" fill="rgba(196,208,186,0.28)" stroke="#5C7A52" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M121 121 C158 148 172 172 210 210 C172 172 148 158 121 121" fill="rgba(196,208,186,0.22)" stroke="#5C7A52" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M210 210 C248 248 262 272 299 299 C272 262 248 248 210 210" fill="rgba(196,208,186,0.22)" stroke="#5C7A52" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M299 121 C272 158 248 172 210 210 C248 172 272 148 299 121" fill="rgba(196,208,186,0.22)" stroke="#5C7A52" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M210 210 C172 248 148 262 121 299 C158 272 172 248 210 210" fill="rgba(196,208,186,0.22)" stroke="#5C7A52" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="210" cy="210" r="16" fill="none" stroke="#5C7A52" stroke-width="1.4"/>
      <circle cx="210" cy="210" r="5.5" fill="#5C7A52"/>
    </svg>
  </div>
</section>

{d.therapyBlocks.map((therapy, i) => (
  <section class="therapy-block reveal" id={therapy.id}>
    <div class="therapy-meta">
      <div class="therapy-icon" set:html={icons[therapy.id] || icons.herbal}></div>
      <p class="therapy-label">{therapy.label}</p>
      <h2>{therapy.title}</h2>
      <div class="therapy-details">
        {therapy.duration && (
          <div class="therapy-detail">
            <span class="detail-label">Duration</span>
            <span class="detail-value">{therapy.duration}</span>
          </div>
        )}
        {therapy.format && (
          <div class="therapy-detail">
            <span class="detail-label">Format</span>
            <span class="detail-value">{therapy.format}</span>
          </div>
        )}
        {therapy.price && (
          <div class="therapy-detail">
            <span class="detail-label">Price</span>
            <span class="detail-value">{therapy.price}</span>
          </div>
        )}
      </div>
      {therapy.bookLabel && (
        <a
          href={therapy.calendlyUrl || (therapy.id === 'ihm' ? '/book#ihm' : '/book')}
          class="btn-enquire"
          target={therapy.calendlyUrl ? '_blank' : undefined}
          rel={therapy.calendlyUrl ? 'noopener' : undefined}
        >{therapy.bookLabel}</a>
      )}
    </div>
    <div class="therapy-content">
      {therapy.paragraphs.map(p => <p>{p}</p>)}
    </div>
  </section>
))}

<section class="th-cta">
  <h2 class="reveal">Not sure where to start?</h2>
  <p class="reveal">The free discovery call exists precisely for this. Fifteen minutes to tell me where you are, what you have already tried, and what you need. I will be honest about whether I think I can help — and if I am not the right fit, I will tell you that too.</p>
  <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="reveal">Book a free discovery call</a>
</section>
