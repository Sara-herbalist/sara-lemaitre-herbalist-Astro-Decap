---
<BaseLayout {...meta}>
<style>
.th-hero {
  padding: 10rem 5rem 7rem;
  background: var(--charcoal);
  max-width: 800px;
}
.th-hero .eyebrow { color: var(--sage-mid); margin-bottom: 1.5rem; }
.th-hero h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--warm-white);
  line-height: 1.1;
  margin-bottom: 2rem;
}
.th-hero-intro {
  color: rgba(247,243,238,.55);
  line-height: 1.9;
  margin-bottom: 1rem;
  font-size: 1.0625rem;
  max-width: 640px;
}
.th-hero-intro + .th-hero-intro { margin-top: 1rem; }

/* Therapy blocks */
.therapy-block {
  padding: 7rem 5rem;
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 6rem;
  align-items: start;
  border-bottom: 1px solid rgba(122,108,100,.08);
}
.therapy-block:nth-child(even) {
  background: var(--cream);
  grid-template-columns: 1.5fr 1fr;
}
.therapy-block:nth-child(even) .therapy-meta { order: 2; }
.therapy-block:nth-child(even) .therapy-content { order: 1; }
.therapy-block:nth-child(odd) { background: var(--warm-white); }

.therapy-icon {
  width: 48px; height: 48px;
  margin-bottom: 1.5rem;
}
.therapy-label {
  font-size: .7rem;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--sage-text);
  margin-bottom: .75rem;
}
.therapy-block h2 {
  font-size: clamp(1.6rem, 2.5vw, 2.2rem);
  color: var(--charcoal);
  line-height: 1.2;
  margin-bottom: 1.5rem;
}
.therapy-details {
  display: flex;
  flex-direction: column;
  gap: .6rem;
  margin-bottom: 2rem;
}
.therapy-detail {
  display: flex;
  gap: 1rem;
  align-items: baseline;
}
.detail-label {
  font-size: .7rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--sage-text);
  min-width: 68px;
  flex-shrink: 0;
}
.detail-value { font-size: .9rem; color: var(--muted); }
.therapy-photo {
  margin-bottom: 1.5rem;
  aspect-ratio: 4/3;
  overflow: hidden;
}
.therapy-photo img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(.87) saturate(.85);
}
.btn-enquire {
  display: inline-block;
  padding: .85rem 2rem;
  border: 1px solid var(--bark);
  color: var(--bark);
  font-size: .8125rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  transition: all .22s;
}
.btn-enquire:hover { background: var(--bark); color: var(--warm-white); }

.therapy-content p {
  color: var(--muted);
  line-height: 1.95;
  margin-bottom: 1.4rem;
  font-size: 1.0375rem;
}

/* CTA bottom */
.th-cta {
  padding: 8rem 5rem;
  background: var(--sage-dark);
  text-align: center;
}
.th-cta h2 {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  color: var(--cream);
  margin-bottom: 1rem;
}
.th-cta p { color: rgba(247,243,238,.6); margin-bottom: 2.5rem; max-width: 500px; margin-left: auto; margin-right: auto; }
.th-cta a {
  display: inline-block;
  padding: 1.1rem 3rem;
  background: var(--bark);
  color: var(--cream);
  font-size: .875rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  transition: background .22s;
}
.th-cta a:hover { background: var(--bark-light); }

@media (max-width: 1024px) {
  .th-hero { padding: 8rem 2.5rem 5rem; }
  .therapy-block, .therapy-block:nth-child(even) {
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 5rem 2.5rem;
  }
  .therapy-block:nth-child(even) .therapy-meta,
  .therapy-block:nth-child(even) .therapy-content { order: unset; }
  .th-cta { padding: 5rem 2.5rem; }
}
</style>

<section class="th-hero">
  <p class="eyebrow">The therapies</p>
  <h1>{d.pageTitle}</h1>
  {d.pageDesc.split('\n\n').map(p => <p class="th-hero-intro">{p}</p>)}
</section>

{d.therapyBlocks.map((therapy, i) => (
  <section class="therapy-block reveal" id={therapy.id}>
    <div class="therapy-meta">
      {therapy.photo && therapy.photo !== `/images/${therapy.id}.jpg` && (
        <div class="therapy-photo">
          <img src={therapy.photo} alt={therapy.title} loading="lazy" />
        </div>
      )}
      <div class="therapy-icon" set:html={icons[therapy.id] || icons.herbal}></div>
      <p class="therapy-label">{therapy.label}</p>
      <h2>{therapy.title}</h2>
      <div class="therapy-details">
        {therapy.duration && (
          <div class="therapy-detail">
            <span class="detail-label">Duration</span>
            <span class="detail-value">{therapy.duration}</span>
          </div>
        )}
        {therapy.format && (
          <div class="therapy-detail">
            <span class="detail-label">Format</span>
            <span class="detail-value">{therapy.format}</span>
          </div>
        )}
        {therapy.price && (
          <div class="therapy-detail">
            <span class="detail-label">Price</span>
            <span class="detail-value">{therapy.price}</span>
          </div>
        )}
      </div>
      {therapy.bookLabel && (
        <a
          href={therapy.calendlyUrl || (therapy.id === 'ihm' ? s.calendlyIhm : '#contact')}
          class="btn-enquire"
          target={therapy.calendlyUrl ? '_blank' : undefined}
          rel={therapy.calendlyUrl ? 'noopener' : undefined}
        >{therapy.bookLabel}</a>
      )}
    </div>
    <div class="therapy-content">
      {therapy.paragraphs.map(p => <p>{p}</p>)}
    </div>
  </section>
))}

<section class="th-cta">
  <h2 class="reveal">Not sure where to start?</h2>
  <p class="reveal">The free discovery call exists precisely for this. Fifteen minutes to tell me where you are, what you have already tried, and what you need. I will be honest about whether I think I can help — and if I am not the right fit, I will tell you that too.</p>
  <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="reveal">Book a free discovery call</a>
</section>
