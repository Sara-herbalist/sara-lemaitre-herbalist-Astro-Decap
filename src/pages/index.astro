---

<BaseLayout {...meta}>
<style>
.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #3D3229;
}
.hero-left {
  padding: 10rem 5rem 6rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #3D3229;
}
.hero-eyebrow { font-size: .75rem; letter-spacing: .22em; text-transform: uppercase; color: var(--sage-light); margin-bottom: 2rem; }
.hero h1 { font-size: clamp(3.5rem, 6vw, 6rem); color: var(--warm-white); line-height: 1.0; margin-bottom: .3rem; }
.hero h1 em { color: var(--sage-light); font-style: italic; display: block; }
.hero-credentials { font-size: .8125rem; color: rgba(247,243,238,.4); line-height: 1.9; margin: 1.5rem 0 2rem; letter-spacing: .04em; }
.hero-body { font-size: 1.0625rem; color: rgba(247,243,238,.65); line-height: 1.9; max-width: 520px; margin-bottom: 2.5rem; }
.hero-body p { margin-bottom: 1rem; }
.hero-body p:last-child { margin-bottom: 0; }
.hero-body strong { color: rgba(247,243,238,.92); font-weight: 400; }
.hero-ctas { display: flex; flex-direction: column; gap: 1rem; width: fit-content; }
.btn-sage { display: inline-block; padding: 1rem 2.5rem; background: var(--sage-pale); color: #3D3229; font-size: .875rem; letter-spacing: .16em; text-transform: uppercase; transition: background .22s; font-weight: 500; }
.btn-sage:hover { background: var(--sage-light); }
.btn-ghost { display: inline-block; padding: 1rem 2.5rem; border: 1px solid rgba(247,243,238,.25); color: rgba(247,243,238,.7); font-size: .875rem; letter-spacing: .16em; text-transform: uppercase; transition: all .22s; }
.btn-ghost:hover { border-color: rgba(247,243,238,.6); color: rgba(247,243,238,.9); }
.hero-right { position: relative; overflow: hidden; background: var(--sage-pale); display: flex; align-items: center; justify-content: center; }
.hero-botanical svg { width: min(380px, 80%); height: auto; }
.hero-photo { width: 100%; height: 100%; object-fit: cover; object-position: top center; filter: brightness(.82) saturate(.85); }
.scroll-hint { margin-top: 3rem; display: flex; align-items: center; gap: .75rem; font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(247,243,238,.25); }
.scroll-hint::before { content: ''; display: block; width: 1px; height: 36px; background: rgba(247,243,238,.15); }
.info-bar { background: #3D3229; border-top: 1px solid rgba(247,243,238,.06); padding: 1.2rem 5rem; display: flex; gap: 3rem; align-items: center; overflow-x: auto; }
.info-item { display: flex; flex-direction: column; gap: .2rem; flex-shrink: 0; }
.info-label { font-size: .65rem; letter-spacing: .2em; text-transform: uppercase; color: rgba(247,243,238,.32); }
.info-value { font-size: .875rem; color: rgba(247,243,238,.62); letter-spacing: .04em; }
.practice { padding: 8rem 5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; background: var(--cream); }
.practice-text .eyebrow { margin-bottom: 1.5rem; }
.practice-text h2 { font-size: clamp(2rem, 3.5vw, 3rem); color: var(--charcoal); margin-bottom: 2rem; }
.practice-text p { color: var(--muted); line-height: 1.9; margin-bottom: 1.5rem; }
.practice-text .read-more { display: inline-flex; align-items: center; gap: .5rem; font-size: .8125rem; letter-spacing: .16em; text-transform: uppercase; color: var(--bark); margin-top: .5rem; }
.practice-text .read-more::after { content: '→'; }
.practice-visual { display: flex; flex-direction: column; gap: 2rem; }
.practice-photo { aspect-ratio: 4/5; overflow: hidden; }
.practice-photo img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.88) saturate(.85); }
.practice-quote { padding: 2rem; border-left: 2px solid var(--sage-light); background: var(--sage-pale); }
.practice-quote p { font-family: var(--font-serif); font-size: 1.125rem; font-style: italic; color: var(--sage-text); line-height: 1.7; }
.practice-quote cite { display: block; margin-top: .75rem; font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--sage-mid); font-style: normal; }
.who { padding: 8rem 5rem; background: var(--warm-white); }
.who-header { max-width: 640px; margin-bottom: 5rem; text-align: left; }
.who-header h2 { font-size: clamp(2rem, 3.5vw, 2.8rem); margin-bottom: 1.5rem; }
.who-header p { color: var(--muted); }
.who-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
.who-card { padding: 3rem 2.5rem; background: var(--cream); transition: background .3s; }
.who-card:hover { background: var(--sage-pale); }
.who-card-number { font-family: var(--font-serif); font-size: 3rem; color: var(--sage-light); font-style: italic; line-height: 1; margin-bottom: 1.5rem; }
.who-card-title { font-family: var(--font-serif); font-size: 1.4rem; color: var(--charcoal); margin-bottom: 1rem; }
.who-card-desc { font-size: .9375rem; color: var(--muted); line-height: 1.8; margin-bottom: 1.5rem; }
.who-card-tags { display: flex; flex-wrap: wrap; gap: .4rem; }
.who-tag { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; padding: .3rem .75rem; border: 1px solid var(--sage-light); color: var(--sage-text); }
.offer { padding: 8rem 5rem; background: #3D3229; }
.offer-header { text-align: center; margin-bottom: 4rem; }
.offer-header h2 { font-size: clamp(2rem, 3.5vw, 2.8rem); color: var(--warm-white); margin-bottom: 1.5rem; }
.offer-header p { color: rgba(247,243,238,.45); max-width: 620px; margin: 0 auto; line-height: 1.85; }
.offer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(247,243,238,.05); margin-bottom: 3rem; }
.offer-card { background: #3D3229; padding: 2.5rem 2rem; border: 1px solid rgba(247,243,238,.07); transition: background .3s, border-color .3s; display: flex; flex-direction: column; }
.offer-card:hover { background: rgba(247,243,238,.03); border-color: rgba(196,208,186,.18); }
.offer-icon { width: 44px; height: 44px; margin-bottom: 1.5rem; }
.offer-card h3 { font-family: var(--font-serif); font-size: 1.2rem; color: var(--warm-white); margin-bottom: 1rem; line-height: 1.25; }
.offer-card p { font-size: .875rem; color: rgba(247,243,238,.4); line-height: 1.8; flex: 1; margin-bottom: 1.5rem; }
.offer-card .read-more { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--sage-mid); display: flex; align-items: center; gap: .4rem; transition: color .2s; }
.offer-card .read-more::after { content: '→'; }
.offer-card:hover .read-more { color: var(--sage-light); }
.offer-footer { text-align: center; }
.offer-footer a { font-size: .8125rem; letter-spacing: .16em; text-transform: uppercase; color: rgba(196,208,186,.5); transition: opacity .2s; }
.offer-footer a:hover { opacity: 1; color: var(--sage-light); }
.story-pull { padding: 8rem 5rem; background: var(--bark); display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: center; }
.story-pull-text .eyebrow { color: rgba(247,243,238,.4); }
.story-pull-text h2 { font-size: clamp(2.2rem, 4vw, 3.5rem); color: var(--warm-white); line-height: 1.1; margin-bottom: 1.5rem; }
.story-pull-text h2 em { color: var(--sage-light); }
.story-pull-text p { color: rgba(247,243,238,.6); margin-bottom: 2rem; line-height: 1.85; }
.story-pull-text a { display: inline-flex; align-items: center; gap: .5rem; font-size: .8125rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sage-light); }
.story-pull-text a::after { content: '→'; }
.story-pull-quote { background: var(--charcoal); padding: 2.5rem; }
.story-pull-quote p { font-family: var(--font-serif); font-size: 1.125rem; font-style: italic; color: var(--sage-light); line-height: 1.7; margin-bottom: .75rem; }
.story-pull-quote cite { font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); font-style: normal; }
.story-pull-photo-wrap { position: relative; }
.story-pull-photo { aspect-ratio: 3/4; overflow: hidden; }
.story-pull-photo img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.75) saturate(.8); }
.process { padding: 8rem 5rem; background: var(--sage-pale); }
.process-header { text-align: center; margin-bottom: 5rem; }
.process-header h2 { font-size: clamp(2rem, 3.5vw, 2.8rem); }
.process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3rem; position: relative; }
.process-steps::before { content: ''; position: absolute; top: 28px; left: calc(12.5% + 1.5rem); right: calc(12.5% + 1.5rem); height: 1px; background: var(--sage-light); opacity: .5; }
.process-step { text-align: center; }
.process-dot { width: 56px; height: 56px; border-radius: 50%; border: 1px solid var(--sage-light); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-family: var(--font-serif); font-size: 1.25rem; font-style: italic; color: var(--sage-text); background: var(--sage-pale); position: relative; z-index: 1; }
.process-step h3 { font-family: var(--font-serif); font-size: 1.25rem; margin-bottom: .75rem; }
.process-step p { font-size: 1rem; color: var(--muted); line-height: 1.8; }
.testimonials { padding: 8rem 5rem; background: var(--warm-white); }
.testimonials-header { text-align: center; margin-bottom: 4rem; }
.testimonials-header h2 { font-size: clamp(2rem, 3vw, 2.5rem); }
.testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
.testimonial-card { padding: 2.5rem; background: var(--cream); border-top: 2px solid var(--sage-light); }
.testimonial-card.placeholder { border-top-color: rgba(196,208,186,.3); }
.testimonial-text { font-family: var(--font-serif); font-size: 1.0625rem; font-style: italic; color: var(--charcoal); line-height: 1.75; margin-bottom: 1.5rem; }
.placeholder .testimonial-text { color: var(--sage-light); font-size: 1rem; }
.testimonial-author { font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
.testimonial-condition { font-size: .75rem; color: var(--sage-mid); margin-top: .25rem; }
.international { padding: 8rem 5rem; background: #3D3229; display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; }
.international-text .eyebrow { color: var(--sage-mid); }
.international-text h2 { font-size: clamp(2rem, 3.5vw, 2.8rem); color: var(--warm-white); margin-bottom: 1.5rem; }
.international-text h2 em { color: var(--sage-light); }
.international-text p { color: rgba(247,243,238,.55); margin-bottom: 1rem; line-height: 1.85; }
.lang-flags { display: flex; gap: 1.5rem; margin-top: 2rem; font-size: 1rem; color: rgba(247,243,238,.6); }
.regions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(247,243,238,.05); align-self: center; }
.region-item { padding: 1.5rem 2rem; background: #3D3229; border: 1px solid rgba(247,243,238,.06); }
.region-name { font-size: .8125rem; letter-spacing: .1em; color: rgba(247,243,238,.7); margin-bottom: .3rem; }
.region-desc { font-size: .875rem; color: rgba(247,243,238,.35); }
.final-cta { padding: 10rem 5rem; background: var(--sage-dark); text-align: center; }
.final-cta h2 { font-size: clamp(2.2rem, 4vw, 3.5rem); color: var(--cream); margin-bottom: 1.5rem; line-height: 1.2; }
.final-cta p { color: rgba(247,243,238,.6); max-width: 520px; margin: 0 auto 3rem; }
.final-cta .cta-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.btn-primary-light { display: inline-block; padding: 1rem 2.5rem; background: var(--sage-pale); color: var(--sage-text); font-size: 1rem; letter-spacing: .16em; text-transform: uppercase; transition: background .22s; font-weight: 500; }
.btn-primary-light:hover { background: var(--sage-light); }
.btn-ghost-light { display: inline-block; padding: 1rem 2.5rem; border: 1px solid rgba(247,243,238,.3); color: rgba(247,243,238,.75); font-size: 1rem; letter-spacing: .16em; text-transform: uppercase; transition: all .22s; }
.btn-ghost-light:hover { border-color: rgba(247,243,238,.7); color: white; }
.section-divider { display: flex; align-items: center; justify-content: center; gap: 1.5rem; padding: 1rem 0; background: var(--warm-white); }
.section-divider::before, .section-divider::after { content: ''; flex: 1; height: 1px; background: var(--sage-light); opacity: .5; max-width: 200px; }
.section-divider svg { flex-shrink: 0; width: 32px; height: 32px; }

@media (max-width: 1024px) {
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-left { padding: 8rem 2.5rem 4rem; }
  .hero-right { height: 60vw; }
  .hero-botanical { padding: 1.5rem; display: flex; justify-content: center; align-items: center; }
  .hero-botanical svg { width: min(200px, 50vw); height: auto; }
  .info-bar { padding: 1rem 1.5rem; gap: 0.75rem 1.5rem; flex-wrap: wrap; }
  .info-item { flex-shrink: 1; min-width: 45%; }
  .info-value { font-size: .75rem; letter-spacing: 0; }
  .practice, .story-pull, .international { grid-template-columns: 1fr; gap: 3rem; padding: 5rem 2.5rem; }
  .who, .offer, .process, .testimonials, .final-cta { padding: 5rem 2.5rem; }
  .who-grid { grid-template-columns: 1fr; gap: 2px; }
  .offer-grid { grid-template-columns: 1fr 1fr; }
  .process-steps { grid-template-columns: 1fr 1fr; gap: 2rem; }
  .process-steps::before { display: none; }
  .testimonials-grid { grid-template-columns: 1fr; }
  .regions-grid { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .offer-grid { grid-template-columns: 1fr; }
  .process-steps { grid-template-columns: 1fr; }
  .hero-ctas { width: 100%; }
  .btn-sage, .btn-ghost { width: 100%; text-align: center; }
}
