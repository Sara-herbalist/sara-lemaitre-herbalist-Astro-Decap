---
import BaseLayout from '../layouts/BaseLayout.astro';
const d = (await import('../data/homepage.json')).default;
const s = (await import('../data/settings.json')).default;
const meta = {
  title: 'Sara Lemaitre | Clinical Herbalist & Naturopath | Hormonal Health, Endometriosis, PMOS',
  description: 'Clinical herbalist and naturopath specialising in endometriosis, PMOS and chronic fatigue. Former elite athlete. Online consultations in English and French.',
  canonical: 'https://www.saralemaitre.com',
  currentPage: 'index',
};

