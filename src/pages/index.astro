---
import BaseLayout from '../layouts/BaseLayout.astro';
const d = (await import('../data/homepage.json')).default;
const s = (await import('../data/settings.json')).default;
const meta = {
  title: 'Sara Lemaitre | Clinical Herbalist & Naturopath | Hormonal Health, Endometriosis, PCOS',
  description: 'Clinical herbalist and naturopath specialising in endometriosis, PCOS and chronic fatigue. Former elite athlete. Online consultations in English and French.',
  canonical: 'https://www.saralemaitre.com',
  currentPage: 'index',
};

const botanicalSVG = `<svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <circle cx="110" cy="110" r="100" fill="none" stroke="rgba(196,208,186,0.18)" stroke-width="0.6" stroke-dasharray="3 6"/>
  <circle cx="110" cy="110" r="72" fill="none" stroke="rgba(196,208,186,0.25)" stroke-width="0.6" stroke-dasharray="2.5 4"/>
  <circle cx="110" cy="110" r="48" fill="none" stroke="rgba(196,208,186,0.45)" stroke-width="0.7"/>
  <path d="M110 62 Q126 86 110 110 Q94 86 110 62" fill="none" stroke="rgba(196,208,186,0.9)" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M110 110 Q126 134 110 158 Q94 134 110 110" fill="none" stroke="rgba(196,208,186,0.9)" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M62 110 Q86 94 110 110 Q86 126 62 110" fill="none" stroke="rgba(196,208,186,0.9)" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M110 110 Q134 94 158 110 Q134 126 110 110" fill="none" stroke="rgba(196,208,186,0.9)" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M110 110 Q126 94 138 78 Q124 100 110 110" fill="none" stroke="rgba(196,208,186,0.5)" stroke-width="0.7" stroke-linecap="round"/>
  <path d="M110 110 Q94 94 82 78 Q96 100 110 110" fill="none" stroke="rgba(196,208,186,0.5)" stroke-width="0.7" stroke-linecap="round"/>
  <path d="M110 110 Q126 126 138 142 Q124 120 110 110" fill="none" stroke="rgba(196,208,186,0.5)" stroke-width="0.7" stroke-linecap="round"/>
  <path d="M110 110 Q94 126 82 142 Q96 120 110 110" fill="none" stroke="rgba(196,208,186,0.5)" stroke-width="0.7" stroke-linecap="round"/>
  <circle cx="110" cy="110" r="4" fill="none" stroke="rgba(196,208,186,0.9)" stroke-width="0.9"/>
  <circle cx="110" cy="110" r="1.5" fill="rgba(196,208,186,0.9)"/>
  <line x1="110" y1="158" x2="110" y2="175" stroke="rgba(196,208,186,0.5)" stroke-width="0.7" stroke-linecap="round"/>
  <path d="M110 170 Q103 163 99 156" fill="none" stroke="rgba(196,208,186,0.4)" stroke-width="0.6" stroke-linecap="round"/>
  <path d="M110 170 Q117 163 121 156" fill="none" stroke="rgba(196,208,186,0.4)" stroke-width="0.6" stroke-linecap="round"/>
</svg>`;

const dividerSVG = `<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <circle cx="16" cy="16" r="14" fill="none" stroke="var(--sage-light)" stroke-width="0.5" stroke-dasharray="2.5 3.5" opacity="0.6"/>
  <circle cx="16" cy="16" r="9" fill="none" stroke="var(--sage-dark)" stroke-width="0.7"/>
  <path d="M16 7 Q19 11.5 16 16 Q13 11.5 16 7" fill="none" stroke="var(--sage-dark)" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M16 16 Q19 20.5 16 25 Q13 20.5 16 16" fill="none" stroke="var(--sage-dark)" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M7 16 Q11.5 13 16 16 Q11.5 19 7 16" fill="none" stroke="var(--sage-dark)" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M16 16 Q20.5 13 25 16 Q20.5 19 16 16" fill="none" stroke="var(--sage-dark)" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="16" cy="16" r="1.5" fill="none" stroke="var(--sage-dark)" stroke-width="0.7"/>
</svg>`;
---

<BaseLayout {...meta}>
<style>
/* ── Hero ─────────────────────────────────────────────── */
.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--charcoal);
}
.hero-left {
  padding: 10rem 5rem 6rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.hero-eyebrow {
  font-size: .75rem;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--sage-light);
  margin-bottom: 2rem;
}
.hero h1 {
  font-size: clamp(3.5rem, 6vw, 6rem);
  color: var(--warm-white);
  line-height: 1.0;
  margin-bottom: .3rem;
}
.hero h1 em { color: var(--sage-light); }
.hero-credentials {
  font-size: .8125rem;
  color: rgba(247,243,238,.4);
  line-height: 1.9;
  margin: 1.5rem 0 2rem;
  letter-spacing: .04em;
}
.hero-body {
  font-size: 1.0625rem;
  color: rgba(247,243,238,.65);
  line-height: 1.9;
  max-width: 520px;
  margin-bottom: 2.5rem;
  white-space: pre-line;
}
.hero-body strong { color: rgba(247,243,238,.9); font-weight: 400; }
.hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
.btn-primary {
  display: inline-block;
  padding: 1rem 2.5rem;
  background: var(--bark);
  color: var(--warm-white);
  font-size: .875rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  transition: background .22s;
}
.btn-primary:hover { background: var(--bark-light); }
.btn-ghost {
  display: inline-block;
  padding: 1rem 2.5rem;
  border: 1px solid rgba(247,243,238,.25);
  color: rgba(247,243,238,.7);
  font-size: .875rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  transition: all .22s;
}
.btn-ghost:hover { border-color: rgba(247,243,238,.6); color: rgba(247,243,238,.9); }
.hero-right {
  position: relative;
  overflow: hidden;
}
.hero-right .hero-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  filter: brightness(.75) saturate(.8);
}
.hero-botanical {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-botanical svg { width: min(380px, 80%); height: auto; }
.scroll-hint {
  position: absolute;
  bottom: 2.5rem;
  left: 5rem;
  display: flex;
  align-items: center;
  gap: .75rem;
  font-size: .7rem;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(247,243,238,.3);
}
.scroll-hint::before {
  content: '';
  display: block;
  width: 1px;
  height: 40px;
  background: rgba(247,243,238,.2);
}

/* ── Info bar ─────────────────────────────────────────── */
.info-bar {
  background: var(--bark);
  padding: 1.2rem 5rem;
  display: flex;
  gap: 3rem;
  align-items: center;
  overflow-x: auto;
}
.info-item {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  flex-shrink: 0;
}
.info-label {
  font-size: .65rem;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(247,243,238,.45);
}
.info-value {
  font-size: .875rem;
  color: rgba(247,243,238,.8);
  letter-spacing: .04em;
}

/* ── Practice ─────────────────────────────────────────── */
.practice {
  padding: 8rem 5rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: start;
  background: var(--cream);
}
.practice-text .eyebrow { margin-bottom: 1.5rem; }
.practice-text h2 {
  font-size: clamp(2rem, 3.5vw, 3rem);
  color: var(--charcoal);
  margin-bottom: 2rem;
}
.practice-text p {
  color: var(--muted);
  line-height: 1.9;
  margin-bottom: 1.5rem;
}
.practice-text .read-more {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  font-size: .8125rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--bark);
  margin-top: .5rem;
}
.practice-text .read-more::after { content: '→'; }
.practice-visual {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}
.practice-photo {
  aspect-ratio: 4/5;
  overflow: hidden;
}
.practice-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(.88) saturate(.85);
}
.practice-quote {
  padding: 2rem;
  border-left: 2px solid var(--sage-light);
  background: var(--sage-pale);
}
.practice-quote p {
  font-family: var(--font-serif);
  font-size: 1.125rem;
  font-style: italic;
  color: var(--sage-text);
  line-height: 1.7;
}
.practice-quote cite {
  display: block;
  margin-top: .75rem;
  font-size: .75rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--sage-mid);
  font-style: normal;
}

/* ── Who I work with ──────────────────────────────────── */
.who {
  padding: 8rem 5rem;
  background: var(--warm-white);
}
.who-header {
  max-width: 640px;
  margin: 0 auto 5rem;
  text-align: center;
}
.who-header h2 {
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  margin-bottom: 1.5rem;
}
.who-header p { color: var(--muted); }
.who-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
}
.who-card {
  padding: 3rem 2.5rem;
  background: var(--cream);
  position: relative;
  transition: background .3s;
}
.who-card:hover { background: var(--sage-pale); }
.who-card-number {
  font-family: var(--font-serif);
  font-size: 3rem;
  color: var(--sage-light);
  font-style: italic;
  line-height: 1;
  margin-bottom: 1.5rem;
}
.who-card-title {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  color: var(--charcoal);
  margin-bottom: 1rem;
}
.who-card-desc { font-size: .9375rem; color: var(--muted); line-height: 1.8; margin-bottom: 1.5rem; }
.who-card-tags { display: flex; flex-wrap: wrap; gap: .4rem; }
.who-tag {
  font-size: .7rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  padding: .3rem .75rem;
  border: 1px solid var(--sage-light);
  color: var(--sage-text);
}

/* ── What I offer ─────────────────────────────────────── */
.offer {
  padding: 8rem 5rem;
  background: var(--charcoal);
}
.offer-header { text-align: center; margin-bottom: 4rem; }
.offer-header h2 {
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  color: var(--warm-white);
  margin-bottom: 1.5rem;
}
.offer-header p { color: rgba(247,243,238,.5); max-width: 640px; margin: 0 auto 1.5rem; }
.offer-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1px;
  background: rgba(247,243,238,.06);
  margin-bottom: 3rem;
}
.offer-card {
  background: var(--charcoal);
  padding: 2.5rem 2rem;
  border: 1px solid rgba(247,243,238,.07);
  transition: background .3s, border-color .3s;
  display: flex;
  flex-direction: column;
}
.offer-card:hover {
  background: rgba(247,243,238,.03);
  border-color: rgba(196,208,186,.2);
}
.offer-icon {
  width: 40px;
  height: 40px;
  margin-bottom: 1.5rem;
}
.offer-card h3 {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  color: var(--warm-white);
  margin-bottom: 1rem;
  line-height: 1.25;
}
.offer-card p {
  font-size: .875rem;
  color: rgba(247,243,238,.45);
  line-height: 1.8;
  flex: 1;
  margin-bottom: 1.5rem;
}
.offer-card .read-more {
  font-size: .7rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--sage-mid);
  display: flex;
  align-items: center;
  gap: .4rem;
  transition: color .2s;
}
.offer-card .read-more::after { content: '→'; }
.offer-card:hover .read-more { color: var(--sage-light); }
.offer-footer { text-align: center; }
.offer-footer a {
  font-size: .8125rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--sage-light);
  opacity: .7;
  transition: opacity .2s;
}
.offer-footer a:hover { opacity: 1; }

/* ── Story pull ───────────────────────────────────────── */
.story-pull {
  padding: 8rem 5rem;
  background: var(--bark);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: center;
}
.story-pull-text .eyebrow { color: rgba(247,243,238,.4); }
.story-pull-text h2 {
  font-size: clamp(2.2rem, 4vw, 3.5rem);
  color: var(--warm-white);
  line-height: 1.1;
  margin-bottom: 1.5rem;
}
.story-pull-text h2 em { color: var(--sage-light); }
.story-pull-text p {
  color: rgba(247,243,238,.6);
  margin-bottom: 2rem;
  line-height: 1.85;
}
.story-pull-text a {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  font-size: .8125rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--sage-light);
}
.story-pull-text a::after { content: '→'; }
.story-pull-visual { position: relative; }
.story-pull-photo {
  aspect-ratio: 3/4;
  overflow: hidden;
}
.story-pull-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(.75) saturate(.8);
}
.story-pull-quote {
  position: absolute;
  bottom: -2rem;
  left: -2rem;
  right: 2rem;
  background: var(--charcoal);
  padding: 2rem 2.5rem;
}
.story-pull-quote p {
  font-family: var(--font-serif);
  font-size: 1.0625rem;
  font-style: italic;
  color: var(--sage-light);
  line-height: 1.7;
  margin-bottom: .75rem;
}
.story-pull-quote cite {
  font-size: .7rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--muted);
  font-style: normal;
}

/* ── Process ──────────────────────────────────────────── */
.process {
  padding: 8rem 5rem;
  background: var(--sage-pale);
}
.process-header { text-align: center; margin-bottom: 5rem; }
.process-header h2 { font-size: clamp(2rem, 3.5vw, 2.8rem); }
.process-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3rem;
  position: relative;
}
.process-steps::before {
  content: '';
  position: absolute;
  top: 48px;
  left: calc(12.5% + 1.5rem);
  right: calc(12.5% + 1.5rem);
  height: 1px;
  background: var(--sage-light);
  opacity: .5;
}
.process-step { text-align: center; }
.process-icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 1.5rem;
}
.process-dot {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 1px solid var(--sage-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-style: italic;
  color: var(--sage-text);
  background: var(--sage-pale);
  position: relative;
  z-index: 1;
}
.process-step h3 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  margin-bottom: .75rem;
}
.process-step p { font-size: .9rem; color: var(--muted); line-height: 1.8; }

/* ── Testimonials ─────────────────────────────────────── */
.testimonials {
  padding: 8rem 5rem;
  background: var(--warm-white);
}
.testimonials-header { text-align: center; margin-bottom: 4rem; }
.testimonials-header h2 { font-size: clamp(2rem, 3vw, 2.5rem); }
.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.testimonial-card {
  padding: 2.5rem;
  background: var(--cream);
  border-top: 2px solid var(--sage-light);
}
.testimonial-card.placeholder { border-top-color: rgba(196,208,186,.3); }
.testimonial-text {
  font-family: var(--font-serif);
  font-size: 1.0625rem;
  font-style: italic;
  color: var(--charcoal);
  line-height: 1.75;
  margin-bottom: 1.5rem;
}
.placeholder .testimonial-text { color: var(--sage-light); font-size: .9rem; }
.testimonial-author {
  font-size: .75rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--muted);
}
.testimonial-condition {
  font-size: .75rem;
  color: var(--sage-mid);
  margin-top: .25rem;
}

/* ── International ────────────────────────────────────── */
.international {
  padding: 8rem 5rem;
  background: var(--charcoal);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: start;
}
.international-text .eyebrow { color: var(--sage-mid); }
.international-text h2 {
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  color: var(--warm-white);
  margin-bottom: 1.5rem;
}
.international-text h2 em { color: var(--sage-light); }
.international-text p { color: rgba(247,243,238,.55); margin-bottom: 1rem; line-height: 1.85; }
.lang-flags {
  display: flex;
  gap: 1.5rem;
  margin-top: 2rem;
  font-size: .875rem;
  color: rgba(247,243,238,.6);
}
.regions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: rgba(247,243,238,.06);
  align-self: center;
}
.region-item {
  padding: 1.5rem 2rem;
  background: var(--charcoal);
  border: 1px solid rgba(247,243,238,.06);
}
.region-name {
  font-size: .8125rem;
  letter-spacing: .1em;
  color: rgba(247,243,238,.7);
  margin-bottom: .3rem;
}
.region-desc { font-size: .8rem; color: rgba(247,243,238,.35); }

/* ── Final CTA ────────────────────────────────────────── */
.final-cta {
  padding: 10rem 5rem;
  background: var(--sage-dark);
  text-align: center;
}
.final-cta h2 {
  font-size: clamp(2.2rem, 4vw, 3.5rem);
  color: var(--cream);
  margin-bottom: 1.5rem;
  line-height: 1.2;
}
.final-cta p { color: rgba(247,243,238,.6); max-width: 520px; margin: 0 auto 3rem; }
.final-cta .cta-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

/* ── Responsive ───────────────────────────────────────── */
@media (max-width: 1200px) {
  .offer-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 1024px) {
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-left { padding: 8rem 2.5rem 4rem; }
  .hero-right { height: 60vw; }
  .scroll-hint { left: 2.5rem; }
  .info-bar { padding: 1rem 2.5rem; gap: 2rem; }
  .practice, .story-pull, .international { grid-template-columns: 1fr; gap: 3rem; padding: 5rem 2.5rem; }
  .who, .offer, .process, .testimonials, .final-cta { padding: 5rem 2.5rem; }
  .who-grid { grid-template-columns: 1fr; gap: 2px; }
  .offer-grid { grid-template-columns: 1fr 1fr; }
  .process-steps { grid-template-columns: 1fr 1fr; gap: 2rem; }
  .process-steps::before { display: none; }
  .testimonials-grid { grid-template-columns: 1fr; }
  .regions-grid { grid-template-columns: 1fr; }
  .story-pull-quote { position: static; margin-top: 2rem; }
}
@media (max-width: 640px) {
  .offer-grid { grid-template-columns: 1fr; }
  .process-steps { grid-template-columns: 1fr; }
  .hero-ctas { flex-direction: column; }
}
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero-left">
    <p class="hero-eyebrow">{d.heroEyebrow}</p>
    <h1>Sara<br><em>Lemaitre</em></h1>
    <p class="hero-credentials" set:html={d.heroCredentials.replace(/·/g, '<br>')}></p>
    <p class="hero-body" set:html={d.heroBody.replace(/\n\n/g, '</p><p class="hero-body" style="margin-top:1.5rem">').replace(/You are not the problem\./g, '<strong>You are not the problem.</strong>')}></p>
    <div class="hero-ctas">
      <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="btn-primary">Book a free discovery call</a>
      <a href="/story" class="btn-ghost">Read my story</a>
    </div>
    <div class="scroll-hint" aria-hidden="true">Scroll</div>
  </div>
  <div class="hero-right">
    {d.heroPortrait && d.heroPortrait !== '/images/sara-portrait.jpg'
      ? <img src={d.heroPortrait} alt="Sara Lemaitre — Clinical Herbalist & Naturopath" class="hero-photo" />
      : <div class="hero-botanical" set:html={botanicalSVG} />
    }
  </div>
</section>

<!-- INFO BAR -->
<div class="info-bar" role="complementary" aria-label="Practice information">
  <div class="info-item">
    <span class="info-label">Specialisms</span>
    <span class="info-value">Hormonal health · Athletes · Burnout</span>
  </div>
  <div class="info-item">
    <span class="info-label">Consultations</span>
    <span class="info-value">Online &amp; in person</span>
  </div>
  <div class="info-item">
    <span class="info-label">Languages</span>
    <span class="info-value">English · Français</span>
  </div>
  <div class="info-item">
    <span class="info-label">Available to</span>
    <span class="info-value">UK &amp; international clients</span>
  </div>
</div>

<!-- THE PRACTICE -->
<section class="practice reveal">
  <div class="practice-text">
    <p class="eyebrow">The practice</p>
    <h2 set:html={d.practiceTitle.replace('lived', '<em>lived</em>')}></h2>
    <p>{d.practiceBody1}</p>
    <p>{d.practiceBody2}</p>
    <a href="/story" class="read-more">Read the full story</a>
  </div>
  <div class="practice-visual">
    {d.practicePhoto && d.practicePhoto !== '/images/sara-practice.jpg' && (
      <div class="practice-photo">
        <img src={d.practicePhoto} alt="Sara Lemaitre in practice" loading="lazy" />
      </div>
    )}
    <blockquote class="practice-quote">
      <p>"{d.practiceQuote}"</p>
      <cite>— Sara Lemaitre</cite>
    </blockquote>
  </div>
</section>

<!-- SECTION DIVIDER -->
<div class="section-divider" aria-hidden="true" set:html={`<div class="section-divider">${dividerSVG}</div>`}></div>

<!-- WHO I WORK WITH -->
<section class="who">
  <div class="who-header reveal">
    <h2>{d.whoTitle}</h2>
    <p>{d.whoDesc.split('\n\n')[0]}</p>
    <p>{d.whoDesc.split('\n\n')[1]}</p>
    <p><em>{d.whoDesc.split('\n\n')[2]}</em></p>
  </div>
  <div class="who-grid">
    {d.whoCards.map((card, i) => (
      <div class={`who-card reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
        <div class="who-card-number">{card.number}</div>
        <div class="who-card-title">{card.title}</div>
        <div class="who-card-desc">{card.desc}</div>
        <div class="who-card-tags">
          {card.tags.map(tag => <span class="who-tag">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- WHAT I OFFER -->
<section class="offer">
  <div class="offer-header reveal">
    <h2>What I offer</h2>
    {d.offerIntro.split('\n\n').map(p => <p>{p}</p>)}
  </div>
  <div class="offer-grid">
    {d.offerCards.map((card, i) => (
      <a href={card.href} class={`offer-card reveal${i > 0 ? ` reveal-delay-${i > 3 ? 3 : i}` : ''}`}>
        <h3>{card.title}</h3>
        <p>{card.desc}</p>
        <span class="read-more">Read more</span>
      </a>
    ))}
  </div>
  <div class="offer-footer">
    <a href="/therapies">View all therapies in full →</a>
  </div>
</section>

<!-- STORY PULL -->
<section class="story-pull">
  <div class="story-pull-text reveal">
    <p class="eyebrow">The story behind the practice</p>
    <h2>{d.storyPullH2line1}<br>{d.storyPullH2line2}<br>{d.storyPullH2line3}<br><em>{d.storyPullH2line4}</em></h2>
    <p>{d.storyPullBody}</p>
    <a href="/story">Read my full story</a>
  </div>
  <div class="story-pull-visual reveal reveal-delay-1">
    {d.storyPullPhoto && d.storyPullPhoto !== '/images/sara-story.jpg' ? (
      <>
        <div class="story-pull-photo">
          <img src={d.storyPullPhoto} alt="Sara Lemaitre" loading="lazy" />
        </div>
        <blockquote class="story-pull-quote">
          <p>"{d.storyPullQuote}"</p>
          <cite>— Sara Lemaitre</cite>
        </blockquote>
      </>
    ) : (
      <blockquote class="story-pull-quote" style="position:static;">
        <p>"{d.storyPullQuote}"</p>
        <cite>— Sara Lemaitre</cite>
      </blockquote>
    )}
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="process">
  <div class="process-header reveal">
    <p class="eyebrow">How it works</p>
    <h2>{d.processTitle.split(' to ')[0]} to <em>{d.processTitle.split(' to ')[1]}</em></h2>
  </div>
  <div class="process-steps">
    {d.processSteps.map((step, i) => (
      <div class={`process-step reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
        <div class="process-dot">{String(i + 1).padStart(2, '0')}</div>
        <h3>{step.title}</h3>
        <p>{step.desc}</p>
      </div>
    ))}
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="testimonials">
  <div class="testimonials-header reveal">
    <p class="eyebrow">What clients say</p>
    <h2>In their <em>own words</em></h2>
  </div>
  <div class="testimonials-grid">
    {d.testimonials.map((t, i) => (
      <div class={`testimonial-card reveal${i > 0 ? ` reveal-delay-${i}` : ''}${!t.text ? ' placeholder' : ''}`}>
        <p class="testimonial-text">{t.text || 'Your testimonial will appear here.'}</p>
        <p class="testimonial-author">{t.author}</p>
        {t.condition && <p class="testimonial-condition">{t.condition}</p>}
      </div>
    ))}
  </div>
</section>

<!-- INTERNATIONAL -->
<section class="international">
  <div class="international-text reveal">
    <p class="eyebrow">Available worldwide</p>
    <h2>Your language.<br>Your timezone.<br><em>Your care.</em></h2>
    <p>{d.internationalDesc1}</p>
    <p>{d.internationalDesc2}</p>
    <div class="lang-flags">
      <span>🇬🇧 English</span>
      <span>🇫🇷 Français</span>
    </div>
  </div>
  <div class="regions-grid reveal reveal-delay-1">
    {d.regions.map(r => (
      <div class="region-item">
        <div class="region-name">{r.name}</div>
        <div class="region-desc">{r.desc}</div>
      </div>
    ))}
  </div>
</section>

<!-- FINAL CTA -->
<section class="final-cta">
  <h2 class="reveal">{d.ctaTitle}</h2>
  <p class="reveal">{d.ctaDesc}</p>
  <div class="cta-group reveal">
    <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="btn-primary">Book a free discovery call</a>
    <a href="/pricing" class="btn-ghost">View pricing & packages</a>
  </div>
</section>

