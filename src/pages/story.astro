---
import BaseLayout from '../layouts/BaseLayout.astro';
const d = (await import('../data/story.json')).default;
const s = (await import('../data/settings.json')).default;
const meta = {
  title: 'My Story | Sara Lemaitre — Clinical Herbalist & Naturopath',
  description: 'The story behind the practice. From elite athlete to clinical herbalist and naturopath — and everything that happened in between.',
  canonical: 'https://www.saralemaitre.com/story',
  currentPage: 'story',
};
---
<BaseLayout {...meta}>
<style>
.story-hero {
  padding: 10rem 5rem 7rem;
  background: #3D3229;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 6rem;
  align-items: center;
}
.story-hero-text .eyebrow { color: var(--sage-mid); margin-bottom: 1.5rem; }
.story-hero-text h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--warm-white);
  line-height: 1.1;
  margin-bottom: 2rem;
}
.story-hero-text h1 em { color: var(--sage-light); }
.story-hero-text p {
  color: rgba(247,243,238,.55);
  line-height: 1.9;
  margin-bottom: 1rem;
  font-size: 1.0625rem;
}
.story-hero-text strong { color: rgba(247,243,238,.85); font-weight: 400; }
.hero-photo-frame {
  aspect-ratio: 3/4;
  overflow: hidden;
}
.hero-photo-frame img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: top;
  filter: brightness(.75) saturate(.8);
}
.hero-pull-quote {
  margin-top: 2.5rem;
  padding: 1.5rem 2rem;
  border-left: 2px solid var(--sage-mid);
  background: var(--sage-pale);
}
.hero-pull-quote p {
  font-family: var(--font-serif);
  font-size: 1.125rem;
  font-style: italic;
  color: var(--sage-text);
  line-height: 1.7;
}

/* Shared section styles */
.story-section {
  padding: 7rem 5rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: start;
}
.story-section.full-width {
  grid-template-columns: 1fr;
  max-width: 820px;
  margin: 0 auto;
}
.story-section:nth-child(even) { background: var(--cream); }
.story-section:nth-child(odd) { background: var(--warm-white); }
.story-section-text .section-tag {
  font-size: .7rem;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--sage-text);
  margin-bottom: .5rem;
}
.story-section-text .section-num {
  font-family: var(--font-serif);
  font-size: 5rem;
  color: var(--sage-light);
  font-style: italic;
  line-height: 1;
  margin-bottom: 1.5rem;
  opacity: .5;
}
.story-section-text h2 {
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  color: var(--charcoal);
  margin-bottom: 2rem;
  line-height: 1.25;
}
.story-section-text p {
  color: var(--muted);
  line-height: 1.95;
  margin-bottom: 1.4rem;
  font-size: 1.0375rem;
}
.story-section-text blockquote {
  margin: 2rem 0;
  padding: 1.5rem 2rem;
  border-left: 2px solid var(--sage-light);
  background: var(--sage-pale);
}
.story-section-text blockquote p {
  font-family: var(--font-serif);
  font-size: 1.0625rem;
  font-style: italic;
  color: var(--sage-text);
  margin: 0;
}
.story-photo {
  position: sticky;
  top: 6rem;
}
.story-photo-frame {
  aspect-ratio: 3/4;
  overflow: hidden;
  margin-bottom: 1.5rem;
}
.story-photo-frame img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: top;
  filter: brightness(.85) saturate(.85);
}
.photo-caption {
  font-size: .75rem;
  letter-spacing: .1em;
  color: var(--sage-mid);
  text-align: center;
  font-style: italic;
}

/* Full-width sections */
.story-section-full {
  padding: 7rem 5rem;
  max-width: 720px;
  margin: 0 auto;
}
.story-section-full .section-tag {
  font-size: .7rem;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--sage-text);
  margin-bottom: .5rem;
}
.story-section-full .section-num {
  font-family: var(--font-serif);
  font-size: 5rem;
  color: var(--sage-light);
  font-style: italic;
  line-height: 1;
  margin-bottom: 1.5rem;
  opacity: .5;
}
.story-section-full h2 {
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  color: var(--charcoal);
  margin-bottom: 2rem;
}
.story-section-full p {
  color: var(--muted);
  line-height: 1.95;
  margin-bottom: 1.4rem;
  font-size: 1.0375rem;
}

/* Magnolia section */
.magnolia-section {
  padding: 7rem 5rem;
  background: var(--charcoal);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: start;
}
.magnolia-text .section-num { 
  color: rgba(196,208,186,.3); 
  font-family: var(--font-serif); 
  font-size: 5rem; 
  font-style: italic; 
  line-height: 1; 
  margin-bottom: 1.5rem; 
  opacity: .5; 
}
.magnolia-text p {
  color: rgba(247,243,238,.55);
  line-height: 1.95;
  margin-bottom: 1.4rem;
}
.magnolia-text em { color: var(--sage-light); font-style: italic; }
.magnolia-photo-frame {
  aspect-ratio: 3/4;
  overflow: hidden;
  position: sticky;
  top: 6rem;
}
.magnolia-photo-frame img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(.8) saturate(.75);
}

/* Now section */
.now-section {
  padding: 7rem 5rem;
  background: var(--sage-dark);
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 6rem;
  align-items: center;
}
.now-text .section-tag { color: rgba(247,243,238,.4); }
.now-text .section-num { color: rgba(196,208,186,.25); }
.now-text h2 {
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  color: var(--warm-white);
  margin-bottom: 2rem;
}
.now-text p {
  color: rgba(247,243,238,.65);
  line-height: 1.95;
  margin-bottom: 1.4rem;
}
.now-cta {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  margin-top: 1rem;
  padding: 1rem 2.5rem;
  background: var(--bark);
  color: var(--warm-white);
  font-size: .875rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  transition: background .22s;
}
.now-cta:hover { background: var(--bark-light); }
.credentials-panel {
  background: rgba(0,0,0,.15);
  padding: 2.5rem;
}
.credentials-title {
  font-size: .7rem;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(247,243,238,.35);
  margin-bottom: 1.5rem;
}
.credential-item {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  padding: .75rem 0;
  border-bottom: 1px solid rgba(247,243,238,.06);
}
.credential-item:last-child { border-bottom: none; }
.cred-dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--sage-mid);
  flex-shrink: 0;
  margin-top: .4rem;
}
.cred-name {
  font-size: .875rem;
  color: rgba(247,243,238,.75);
  line-height: 1.4;
}
.cred-detail {
  font-size: .75rem;
  color: rgba(247,243,238,.35);
  margin-top: .1rem;
}
.membership-logos {
  display: flex;
  gap: 1rem;
  align-items: center;
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(247,243,238,.06);
  opacity: .4;
  filter: grayscale(1) brightness(3);
}
.membership-logos img { height: 24px; width: auto; }

@media (max-width: 1024px) {
  .story-hero, .story-section, .magnolia-section, .now-section {
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 5rem 2.5rem;
  }
  .story-section-full { padding: 5rem 2.5rem; }
  .story-photo { position: static; }
  .magnolia-photo-frame { position: static; }
  .hero-photo-frame { aspect-ratio: 16/9; }
}
</style>

<!-- HERO -->
<section class="story-hero">
  <div class="story-hero-text reveal">
    <p class="eyebrow">My story</p>
    <h1>The athlete.<br>The patient.<br><em>The practitioner.</em></h1>
    {d.heroDesc.split('\n\n').map(p => <p set:html={p.replace('You are not the problem.', '<strong>You are not the problem.</strong>')}></p>)}
    <blockquote class="hero-pull-quote">
      <p>"{d.heroPullQuote}"</p>
    </blockquote>
  </div>
  <div class="reveal reveal-delay-1">
    {d.heroPhoto ? (
      <div class="hero-photo-frame">
        <img src={d.heroPhoto} alt="Sara Lemaitre — athlete" loading="eager" />
      </div>
    ) : null}
  </div>
</section>

<!-- SECTION 1: The athlete -->
<section class="story-section reveal">
  <div class="story-section-text">
    <p class="section-tag">01 · The beginning · And the end</p>
    <div class="section-num">01</div>
    <h2>{d.s1h2}</h2>
    {d.s1body.split('\n\n').map(p => <p>{p}</p>)}
    <blockquote><p>{d.s1quote}</p></blockquote>
  </div>
  <div class="story-photo">
    {d.s1photo ? (
      <>
        <div class="story-photo-frame">
          <img src={d.s1photo} alt="Sara Lemaitre training" loading="lazy" />
        </div>
        <p class="photo-caption">Artistic swimming — national level</p>
      </>
    ) : null}
  </div>
</section>

<!-- SECTION 2: The patient -->
<section class="story-section reveal">
  <div class="story-section-text">
    <p class="section-tag">02 · Dismissed · Diagnosed</p>
    <div class="section-num">02</div>
    <h2>{d.s2h2}</h2>
    {d.s2body.split('\n\n').map(p => <p>{p}</p>)}
  </div>
  <div class="story-photo">
    {d.s2photo ? (
      <div class="story-photo-frame">
        <img src={d.s2photo} alt="Sara Lemaitre" loading="lazy" />
      </div>
    ) : null}
  </div>
</section>

<!-- SECTION 3: The discovery -->
<section class="story-section reveal">
  <div class="story-section-text">
    <p class="section-tag">03 · Plant medicine · Holistic health</p>
    <div class="section-num">03</div>
    <h2>{d.s3h2}</h2>
    {d.s3body.split('\n\n').map(p => <p>{p}</p>)}
    <blockquote><p>{d.s3quote}</p></blockquote>
    {d.s3family.split('\n\n').map(p => <p>{p}</p>)}
  </div>
  <div class="story-photo">
    {d.s3photo ? (
      <div class="story-photo-frame">
        <img src={d.s3photo} alt="Sara Lemaitre" loading="lazy" />
      </div>
    ) : null}
  </div>
</section>

<!-- SECTION 4: The training -->
<section class="story-section reveal" style="background: var(--sage-pale);">
  <div class="story-section-text">
    <p class="section-tag">04 · Learning · Clinic practice</p>
    <div class="section-num">04</div>
    <h2>{d.s4h2}</h2>
    {d.s4body.split('\n\n').map(p => <p>{p}</p>)}
  </div>
  <div class="story-photo">
    {d.s4photo ? (
      <div class="story-photo-frame">
        <img src={d.s4photo} alt="Sara Lemaitre in clinic" loading="lazy" />
      </div>
    ) : null}
  </div>
</section>

<!-- SECTION 5: The magnolia -->
<section class="magnolia-section reveal">
  <div class="magnolia-text">
    <p class="section-tag">05 · Resilience · Homecoming</p>
    <div class="section-num">05</div>
    <h2>{d.magnoliaH2}</h2>
    {d.magnoliaBody.split('\n\n').map(p => <p>{p}</p>)}
  </div>
  <div>
    {d.magnoliaPhoto ? (
      <div class="magnolia-photo-frame">
        <img src={d.magnoliaPhoto} alt="The magnolia tree" loading="lazy" />
      </div>
    ) : null}
  </div>
</section>

<!-- SECTION 6: Where I am now -->
<section class="now-section reveal">
  <div class="now-text">
    <p class="section-tag">06 · My practice · My commitment</p>
    <div class="section-num">06</div>
    <h2>{d.nowH2}</h2>
    {d.nowBody.split('\n\n').map(p => <p>{p}</p>)}
    <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="now-cta">Book a free discovery call</a>
  </div>
  <div class="credentials-panel reveal reveal-delay-1">
    <p class="credentials-title">Qualifications &amp; background</p>
    {d.credentials.map(cred => (
      <div class="credential-item">
        <div class="cred-dot"></div>
        <div>
          <div class="cred-name">{cred.name}</div>
          <div class="cred-detail">{cred.detail}</div>
        </div>
      </div>
    ))}
    <div class="membership-logos">
      <img src="/images/anp-logo.png" alt="ANP" />
      <img src="/images/gnc-logo.png" alt="GNC" />
    </div>
  </div>
</section>
</BaseLayout>
