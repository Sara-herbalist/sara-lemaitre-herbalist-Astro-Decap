---
import BaseLayout from '../layouts/BaseLayout.astro';
const d = (await import('../data/book.json')).default;
const s = (await import('../data/settings.json')).default;
const meta = {
  title: 'Book a Consultation | Sara Lemaitre — Clinical Herbalist & Naturopath',
  description: 'Request an initial consultation or book a discovery call with Sara Lemaitre, clinical herbalist and naturopath.',
  canonical: 'https://www.saralemaitre.com/book',
  currentPage: 'book',
};
---
<BaseLayout {...meta}>
<style>
.book-hero {
  padding: 10rem 5rem 7rem;
  background: var(--charcoal);
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 6rem;
  align-items: center;
}
.book-hero-text .eyebrow { color: var(--sage-mid); margin-bottom: 1.5rem; }
.book-hero-text h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--warm-white);
  line-height: 1.1;
  margin-bottom: 1.5rem;
}
.book-hero-text h1 em { color: var(--sage-light); }
.book-hero-text p { color: rgba(247,243,238,.55); line-height: 1.9; }
.book-hero-photo { aspect-ratio: 3/4; overflow: hidden; }
.book-hero-photo img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.75) saturate(.8); }

/* Options grid */
.book-options {
  padding: 6rem 5rem;
  background: var(--warm-white);
}
.book-options-intro { margin-bottom: 4rem; }
.book-options-intro h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); margin-bottom: 1rem; }
.book-options-intro p { color: var(--muted); max-width: 600px; }
.options-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2px;
  margin-bottom: 4rem;
}
.option-card {
  background: var(--cream);
  padding: 2.5rem 2rem;
  border-top: 2px solid var(--sage-light);
  display: flex;
  flex-direction: column;
  transition: background .3s;
}
.option-card:hover { background: var(--sage-pale); }
.option-card.featured {
  border-top-color: var(--sage-dark);
  background: var(--sage-pale);
}
.option-tag {
  font-size: .7rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--sage-text);
  margin-bottom: .75rem;
}
.option-card h3 {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  margin-bottom: .75rem;
}
.option-price {
  font-family: var(--font-serif);
  font-size: 2rem;
  color: var(--charcoal);
  margin-bottom: .5rem;
}
.option-price span {
  font-size: .9rem;
  color: var(--muted);
  font-family: var(--font-sans);
}
.option-card p { font-size: .9rem; color: var(--muted); line-height: 1.8; margin-bottom: 1rem; flex: 1; }
.sliding-note {
  font-size: .8rem;
  font-style: italic;
  color: var(--sage-mid);
  margin-bottom: 1rem;
}
.option-card a {
  display: inline-block;
  padding: .75rem 1.5rem;
  border: 1px solid var(--bark);
  color: var(--bark);
  font-size: .75rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  transition: all .22s;
  text-align: center;
}
.option-card a:hover { background: var(--bark); color: var(--warm-white); }
.option-card.featured a {
  background: var(--bark);
  color: var(--warm-white);
}

/* Includes lists for bundles */
.option-includes {
  list-style: none;
  margin-bottom: 1rem;
  display: flex;
  flex-direction: column;
  gap: .35rem;
}
.option-includes li {
  font-size: .8rem;
  color: var(--muted);
  padding-left: 1rem;
  position: relative;
}
.option-includes li::before { content: '—'; position: absolute; left: 0; color: var(--sage-light); }

/* Get in touch box */
.get-in-touch-box {
  background: var(--sage-pale);
  padding: 2.5rem;
  border-left: 3px solid var(--sage-light);
  margin-bottom: 4rem;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 2rem;
  align-items: center;
}
.get-in-touch-box h3 {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  margin-bottom: .5rem;
}
.get-in-touch-box p { font-size: .9375rem; color: var(--muted); }
.get-in-touch-box a {
  display: inline-block;
  padding: .85rem 2rem;
  border: 1px solid var(--bark);
  color: var(--bark);
  font-size: .8rem;
  letter-spacing: .14em;
  text-transform: uppercase;
  white-space: nowrap;
  transition: all .22s;
}
.get-in-touch-box a:hover { background: var(--bark); color: var(--warm-white); }

/* Payment */
.payment-section {
  padding: 5rem;
  background: var(--cream);
}
.payment-section h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 2rem; }
.payment-section p { color: var(--muted); line-height: 1.9; margin-bottom: 1rem; }
.payment-steps {
  list-style: none;
  counter-reset: steps;
  margin: 2rem 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.payment-steps li {
  counter-increment: steps;
  display: flex;
  gap: 1.5rem;
  align-items: baseline;
  font-size: .9375rem;
  color: var(--muted);
}
.payment-steps li::before {
  content: counter(steps);
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-style: italic;
  color: var(--sage-light);
  flex-shrink: 0;
  width: 1.5rem;
}
.bank-details {
  background: var(--warm-white);
  padding: 2rem;
  border: 1px solid var(--sage-light);
  margin: 1.5rem 0;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: .5rem 2rem;
}
.bank-label {
  font-size: .75rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--sage-text);
}
.bank-value { font-size: .9375rem; color: var(--charcoal); }
.good-to-know {
  list-style: none;
  margin-top: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: .75rem;
}
.good-to-know li {
  font-size: .875rem;
  color: var(--muted);
  padding-left: 1.5rem;
  position: relative;
}
.good-to-know li::before { content: '—'; position: absolute; left: 0; color: var(--sage-light); }

/* Cancel + CTA */
.book-cancel { padding: 5rem; background: var(--warm-white); }
.book-cancel h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 2rem; }
.cancel-tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 1.5rem; }
.cancel-tier { padding: 2rem; background: var(--cream); border-top: 2px solid var(--sage-light); }
.cancel-tier h3 { font-family: var(--font-serif); font-size: 1rem; margin-bottom: .75rem; }
.cancel-tier p { font-size: .875rem; color: var(--muted); line-height: 1.75; }
.cancel-note { font-family: var(--font-serif); font-style: italic; color: var(--muted); }

.book-cta { padding: 8rem 5rem; background: var(--sage-dark); text-align: center; }
.book-cta h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); color: var(--cream); margin-bottom: 1rem; }
.book-cta p { color: rgba(247,243,238,.6); margin-bottom: 2.5rem; }
.book-cta a {
  display: inline-block;
  padding: 1.1rem 3rem;
  background: var(--bark);
  color: var(--cream);
  font-size: .875rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  transition: background .22s;
}
.book-cta a:hover { background: var(--bark-light); }

@media (max-width: 1024px) {
  .book-hero { grid-template-columns: 1fr; gap: 3rem; padding: 8rem 2.5rem 4rem; }
  .book-hero-photo { aspect-ratio: 16/9; }
  .book-options, .payment-section, .book-cancel, .book-cta { padding: 4rem 2.5rem; }
  .options-grid { grid-template-columns: 1fr; }
  .cancel-tiers { grid-template-columns: 1fr; }
  .get-in-touch-box { grid-template-columns: 1fr; }
  .bank-details { grid-template-columns: 1fr; gap: .25rem; }
}
</style>

<!-- HERO -->
<section class="book-hero">
  <div class="book-hero-text reveal">
    <p class="eyebrow">Book a consultation</p>
    <h1>Start your <em>healing journey</em></h1>
    <p>{d.heroDesc}</p>
  </div>
  <div class="reveal reveal-delay-1">
    {d.heroPhoto && d.heroPhoto !== '/images/sara-consultation.jpg' && (
      <div class="book-hero-photo">
        <img src={d.heroPhoto} alt="Sara Lemaitre" loading="eager" />
      </div>
    )}
  </div>
</section>

<!-- OPTIONS -->
<section class="book-options">
  <div class="book-options-intro reveal">
    <h2>Choose your consultation</h2>
    <p>Every consultation is confirmed after a brief review to ensure I can offer the right support. You will hear back within 48 hours.</p>
  </div>

  <div class="options-grid">
    <!-- Discovery -->
    <div class="option-card reveal">
      <span class="option-tag">{d.discoveryTag}</span>
      <h3>{d.discoveryTitle}</h3>
      <div class="option-price">Free</div>
      <p>{d.discoveryDesc}</p>
      <a href={s.calendlyDiscovery} target="_blank" rel="noopener">Book free call</a>
    </div>
    <!-- Initial -->
    <div class="option-card reveal reveal-delay-1">
      <span class="option-tag">{d.initialTag}</span>
      <h3>{d.initialTitle}</h3>
      <div class="option-price">£{d.initialPrice} <span>/ session</span></div>
      <ul class="option-includes">
        {d.initialIncludes.map(i => <li>{i}</li>)}
      </ul>
      <p class="sliding-note">Sliding scale: £{d.initialSlidingScale} for students &amp; low incomes</p>
      <p class="sliding-note" style="color:var(--muted);font-style:normal;">{d.initialNote}</p>
      <a href={`mailto:${s.email}?subject=Initial consultation request`}>Request consultation</a>
    </div>
    <!-- Follow-up -->
    <div class="option-card reveal reveal-delay-2">
      <span class="option-tag">{d.followupTag}</span>
      <h3>{d.followupTitle}</h3>
      <div class="option-price">£{d.followupPrice} <span>/ session</span></div>
      <ul class="option-includes">
        {d.followupIncludes.map(i => <li>{i}</li>)}
      </ul>
      <a href={`mailto:${s.email}?subject=Follow-up consultation request`}>Book follow-up</a>
    </div>
    <!-- Bundle 1 -->
    <div class="option-card reveal">
      <span class="option-tag">{d.bundleTag}</span>
      <h3>{d.bundleTitle}</h3>
      <div class="option-price">£{d.bundlePrice}</div>
      <ul class="option-includes">
        {d.bundleIncludes.map(i => <li>{i}</li>)}
      </ul>
      <p class="sliding-note">Sliding scale: £{d.bundleSlidingScale}</p>
      <a href={`mailto:${s.email}?subject=Bundle consultation request`}>Request bundle</a>
    </div>
    <!-- Bundle 2 -->
    <div class="option-card reveal reveal-delay-1">
      <span class="option-tag">{d.followupBundleTag}</span>
      <h3>{d.followupBundleTitle}</h3>
      <div class="option-price">£{d.followupBundlePrice}</div>
      <ul class="option-includes">
        {d.followupBundleIncludes.map(i => <li>{i}</li>)}
      </ul>
      <a href={`mailto:${s.email}?subject=Follow-up bundle request`}>Request bundle</a>
    </div>
    <!-- IHM -->
    <div class="option-card reveal reveal-delay-2">
      <span class="option-tag">{d.ihmTag}</span>
      <h3>{d.ihmTitle}</h3>
      <div class="option-price">£{d.ihmPrice} <span>/ session</span></div>
      <p>A deeply relaxing Ayurvedic treatment. Standalone or combined with a herbal consultation.</p>
      <a href={s.calendlyIhm} target="_blank" rel="noopener">Book massage</a>
    </div>
  </div>

  <!-- Other services -->
  <div class="get-in-touch-box reveal">
    <div class="git-text">
      <p class="eyebrow" style="margin-bottom:.5rem;">Other services</p>
      <h3>{d.getInTouchTitle}</h3>
      <p>{d.getInTouchDesc}</p>
    </div>
    <a href="/consultancy">Get in touch</a>
  </div>
</section>

<!-- PAYMENT -->
<section class="payment-section reveal">
  <h2>Payment by bank transfer</h2>
  <p>I accept payment by UK bank transfer — straightforward, secure, and fee-free for both of us.</p>
  <ol class="payment-steps">
    <li>Book your appointment using the options above.</li>
    <li>You will receive a confirmation email with bank transfer details.</li>
    <li>Transfer the consultation fee within 24 hours of booking.</li>
    <li>Your appointment is confirmed once payment is received.</li>
  </ol>
  <div class="bank-details">
    <span class="bank-label">Account name</span><span class="bank-value">{d.bankName}</span>
    <span class="bank-label">Sort code</span><span class="bank-value">{d.bankSort}</span>
    <span class="bank-label">Account number</span><span class="bank-value">{d.bankAccount}</span>
    <span class="bank-label">Reference</span><span class="bank-value">Your name + appointment date</span>
  </div>
  <ul class="good-to-know">
    <li>Bank transfer is completely free — no processing fees for you or for me.</li>
    <li>Transfers typically clear within a few hours for the same bank, or by the next working day.</li>
    <li>If you have any difficulty with bank transfer, get in touch and we can find an alternative arrangement.</li>
  </ul>
</section>

<!-- CANCELLATION -->
<section class="book-cancel reveal">
  <h2>Cancellation policy</h2>
  <div class="cancel-tiers">
    {d.cancellationTiers.map(tier => (
      <div class="cancel-tier">
        <h3>{tier.title}</h3>
        <p>{tier.policy}</p>
      </div>
    ))}
  </div>
  <p class="cancel-note">{d.cancellationNote}</p>
</section>

<!-- CTA -->
<section class="book-cta">
  <h2 class="reveal">{d.finalCtaTitle}</h2>
  <p class="reveal">{d.finalCtaDesc}</p>
  <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="reveal">Book your free discovery call</a>
</section>
