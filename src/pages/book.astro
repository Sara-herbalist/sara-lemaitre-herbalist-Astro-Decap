
---
import BaseLayout from '../layouts/BaseLayout.astro';
const d = (await import('../data/book.json')).default;
const s = (await import('../data/settings.json')).default;
const meta = {
  title: 'Book a Consultation | Sara Lemaitre — Clinical Herbalist & Naturopath',
  description: 'Request an initial consultation or book a discovery call with Sara Lemaitre, clinical herbalist and naturopath.',
  canonical: 'https://www.saralemaitre.com/book',
  currentPage: 'book',
};

const petalMark = `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:28px;height:28px;display:block;margin:0 auto 1rem;">
  <circle cx="14" cy="14" r="13" stroke="rgba(196,208,186,0.3)" stroke-width="0.6" stroke-dasharray="2.5 3.5"/>
  <circle cx="14" cy="14" r="9" stroke="rgba(196,208,186,0.72)" stroke-width="0.85"/>
  <path d="M14 5 Q17 9.5 14 14 Q11 9.5 14 5" stroke="rgba(196,208,186,0.72)" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <path d="M14 14 Q17 18.5 14 23 Q11 18.5 14 14" stroke="rgba(196,208,186,0.72)" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <path d="M5 14 Q9.5 11 14 14 Q9.5 17 5 14" stroke="rgba(196,208,186,0.72)" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <path d="M14 14 Q18.5 11 23 14 Q18.5 17 14 14" stroke="rgba(196,208,186,0.72)" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <circle cx="14" cy="14" r="2" stroke="rgba(196,208,186,0.72)" stroke-width="0.85" fill="none"/>
</svg>`;

const petalMarkSage = `<svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:28px;height:28px;display:block;margin:0 auto 1rem;">
  <circle cx="14" cy="14" r="13" stroke="rgba(255,255,255,0.4)" stroke-width="0.6" stroke-dasharray="2.5 3.5"/>
  <circle cx="14" cy="14" r="9" stroke="rgba(255,255,255,0.9)" stroke-width="0.85"/>
  <path d="M14 5 Q17 9.5 14 14 Q11 9.5 14 5" stroke="rgba(255,255,255,0.9)" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <path d="M14 14 Q17 18.5 14 23 Q11 18.5 14 14" stroke="rgba(255,255,255,0.9)" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <path d="M5 14 Q9.5 11 14 14 Q9.5 17 5 14" stroke="rgba(255,255,255,0.9)" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <path d="M14 14 Q18.5 11 23 14 Q18.5 17 14 14" stroke="rgba(255,255,255,0.9)" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <circle cx="14" cy="14" r="2" stroke="rgba(255,255,255,0.9)" stroke-width="0.85" fill="none"/>
</svg>`;
---
<BaseLayout {...meta}>
<style>
.book-hero {
  padding: 10rem 5rem 7rem;
  background: #3D3229;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 6rem;
  align-items: center;
}
.book-hero-text .eyebrow { color: var(--sage-mid); margin-bottom: 1.5rem; }
.book-hero-text h1 {
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: var(--warm-white); line-height: 1.1; margin-bottom: 1.5rem;
}
.book-hero-text h1 em { color: var(--sage-light); }
.book-hero-text p { color: rgba(247,243,238,.55); line-height: 1.9; font-size: 1rem; }
.book-hero-photo { aspect-ratio: 3/4; overflow: hidden; }
.book-hero-photo img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.75) saturate(.8); }

.book-options { padding: 6rem 5rem; background: var(--charcoal); }
.book-options-intro { margin-bottom: 3rem; }
.book-options-intro h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); color: var(--warm-white); margin-bottom: 1rem; }
.book-options-intro p { color: rgba(247,243,238,.5); max-width: 600px; font-size: 1rem; }
.section-label {
  font-size: .75rem; letter-spacing: .22em; text-transform: uppercase;
  color: var(--sage-mid); margin-bottom: 1.5rem; margin-top: 3rem;
}
.section-label:first-of-type { margin-top: 0; }

.discovery-card {
  background: rgba(247,243,238,.04);
  border: 1px solid rgba(247,243,238,.1);
  padding: 2.5rem 3rem;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 3rem;
  align-items: center;
  margin-bottom: 1px;
}
.discovery-price { font-family: var(--font-serif); font-size: 3rem; color: var(--warm-white); font-style: italic; line-height: 1; }
.discovery-title { font-family: var(--font-serif); font-size: 1.4rem; color: var(--warm-white); margin-bottom: .4rem; }
.discovery-tag { font-size: .8125rem; color: rgba(247,243,238,.4); margin-bottom: .75rem; }
.discovery-desc { font-size: 1rem; color: rgba(247,243,238,.5); line-height: 1.75; }
.discovery-cta {
  display: inline-block; padding: 1rem 2.5rem; white-space: nowrap;
  background: var(--sage-pale); color: #3D3229;
  font-size: .875rem; letter-spacing: .16em; text-transform: uppercase;
  font-weight: 500; transition: background .22s;
}
.discovery-cta:hover { background: var(--sage-light); }

.cards-two { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(247,243,238,.05); margin-bottom: 1px; }
.cards-two-bundles { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(247,243,238,.05); margin-bottom: 1px; }

.ihm-card {
  background: rgba(247,243,238,.04);
  border: 1px solid rgba(247,243,238,.1);
  padding: 2.5rem 3rem;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 3rem;
  align-items: center;
}
.ihm-price { font-family: var(--font-serif); font-size: 3rem; color: var(--warm-white); font-style: italic; line-height: 1; }
.ihm-title { font-family: var(--font-serif); font-size: 1.4rem; color: var(--warm-white); margin-bottom: .4rem; }
.ihm-tag { font-size: .8125rem; color: rgba(247,243,238,.4); margin-bottom: .75rem; }
.ihm-desc { font-size: 1rem; color: rgba(247,243,238,.5); line-height: 1.75; }
.ihm-cta {
  display: inline-block; padding: 1rem 2.5rem; white-space: nowrap;
  border: 1px solid rgba(247,243,238,.25); color: rgba(247,243,238,.75);
  font-size: .875rem; letter-spacing: .16em; text-transform: uppercase;
  transition: all .22s;
}
.ihm-cta:hover { border-color: rgba(247,243,238,.6); color: white; }

.pcard {
  background: var(--charcoal); padding: 2rem 1.75rem 1.75rem;
  border: 1px solid rgba(247,243,238,.07);
  display: flex; flex-direction: column;
  transition: border-color .25s;
}
.pcard:hover { border-color: rgba(196,208,186,.2); }
.pcard.featured { background: var(--sage-dark); border-color: var(--sage-dark); }
.pcard.featured:hover { border-color: var(--sage-text); }
.pcard-bundle { border-left: 2px solid rgba(196,208,186,.35) !important; }
.pcard.featured.pcard-bundle { border-left: 2px solid rgba(255,255,255,.3) !important; }
.recommended-badge { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.8); text-align: center; margin-bottom: .5rem; }
.pcard-tag { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: rgba(247,243,238,.3); text-align: center; margin-bottom: .75rem; }
.pcard.featured .pcard-tag { color: rgba(255,255,255,.65); }
.pcard-name { font-family: var(--font-serif); font-size: 1.2rem; color: rgba(247,243,238,.85); text-align: center; margin-bottom: 1.25rem; line-height: 1.3; }
.pcard.featured .pcard-name { color: white; }
.pcard-price { font-family: var(--font-serif); font-size: 2.5rem; color: rgba(247,243,238,.85); text-align: center; line-height: 1; margin-bottom: .4rem; }
.pcard.featured .pcard-price { color: white; }
.pcard-sub { font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(247,243,238,.25); text-align: center; margin-bottom: 1.25rem; }
.pcard.featured .pcard-sub { color: rgba(255,255,255,.55); }
.pcard-divider { height: 1px; background: rgba(247,243,238,.07); margin: 0 0 1.25rem; }
.pcard.featured .pcard-divider { background: rgba(255,255,255,.15); }
.pcard-includes { list-style: none; display: flex; flex-direction: column; gap: .5rem; margin-bottom: 1.5rem; flex: 1; }
.pcard-includes li { font-size: .9rem; color: rgba(247,243,238,.4); padding-left: 1rem; position: relative; line-height: 1.6; }
.pcard.featured .pcard-includes li { color: rgba(255,255,255,.75); }
.pcard-includes li::before { content: '—'; position: absolute; left: 0; color: rgba(196,208,186,.3); }
.pcard.featured .pcard-includes li::before { color: rgba(255,255,255,.4); }
.pcard-sliding { font-family: var(--font-serif); font-size: .9rem; font-style: italic; color: rgba(247,243,238,.25); text-align: center; margin-bottom: 1.25rem; }
.pcard.featured .pcard-sliding { color: rgba(255,255,255,.6); }
.pcard-cta { display: block; text-align: center; padding: .75rem 1rem; border: 1px solid rgba(247,243,238,.15); font-size: .8125rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(247,243,238,.45); transition: all .22s; }
.pcard:hover .pcard-cta { border-color: rgba(247,243,238,.35); color: rgba(247,243,238,.75); }
.pcard.featured .pcard-cta { border-color: rgba(255,255,255,.4); color: white; background: rgba(255,255,255,.1); }
.pcard.featured:hover .pcard-cta { background: rgba(255,255,255,.2); }
.bundle-note { font-size: .875rem; color: rgba(247,243,238,.25); margin-top: 1rem; font-style: italic; text-align: center; }

.investment-section {
  padding: 5rem; background: var(--warm-white);
  display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start;
}
.investment-section h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 2rem; color: var(--charcoal); }
.investment-section p { color: var(--muted); line-height: 1.9; margin-bottom: 1rem; font-size: 1rem; }
.commitment-box {
  background: var(--sage-pale);
  padding: 2rem;
  border-left: 3px solid var(--sage-light);
}
.commitment-box h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 1.5rem; color: var(--charcoal); }
.commitment-box p { color: var(--muted); line-height: 1.9; margin-bottom: 1rem; font-size: 1rem; }
.commitment-box p:last-child { margin-bottom: 0; }

.payment-section {
  padding: 5rem; background: var(--cream);
  display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start;
}
.payment-section h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 2rem; }
.payment-section > div > p { color: var(--muted); line-height: 1.9; margin-bottom: 1rem; font-size: 1rem; }
.payment-steps { list-style: none; counter-reset: steps; margin: 1.5rem 0; display: flex; flex-direction: column; gap: 1rem; }
.payment-steps li { counter-increment: steps; display: flex; gap: 1.5rem; align-items: baseline; font-size: 1rem; color: var(--muted); }
.payment-steps li::before { content: counter(steps); font-family: var(--font-serif); font-size: 1.25rem; font-style: italic; color: var(--sage-light); flex-shrink: 0; width: 1.5rem; }
.bank-box { background: var(--warm-white); padding: 2rem; border: 1px solid var(--sage-light); margin-top: 1.5rem; }
.bank-box h3 { font-family: var(--font-serif); font-size: 1.1rem; margin-bottom: 1rem; }
.good-to-know { list-style: none; margin-top: 1rem; display: flex; flex-direction: column; gap: .75rem; }
.good-to-know li { font-size: 1rem; color: var(--muted); padding-left: 1.5rem; position: relative; line-height: 1.7; }
.good-to-know li::before { content: '—'; position: absolute; left: 0; color: var(--sage-light); }

.book-cancel { padding: 5rem; background: var(--warm-white); }
.book-cancel h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin-bottom: 2rem; }
.cancel-tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 1.5rem; }
.cancel-tier { padding: 2rem; background: var(--cream); border-top: 2px solid var(--sage-light); }
.cancel-tier h3 { font-family: var(--font-serif); font-size: 1rem; margin-bottom: .75rem; }
.cancel-tier p { font-size: 1rem; color: var(--muted); line-height: 1.75; }
.cancel-note-text { font-family: var(--font-serif); font-style: italic; color: var(--muted); font-size: 1rem; }

.book-cta { padding: 8rem 5rem; background: var(--sage-dark); text-align: center; }
.book-cta h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); color: var(--cream); margin-bottom: 1rem; }
.book-cta p { color: rgba(247,243,238,.6); margin-bottom: 2.5rem; font-size: 1rem; }
.book-cta-btn {
  display: inline-block; padding: 1.1rem 3rem;
  background: var(--sage-pale); color: #3D3229;
  font-size: .9375rem; letter-spacing: .18em; text-transform: uppercase;
  transition: background .22s; font-weight: 500;
}
.book-cta-btn:hover { background: var(--sage-light); }

@media (max-width: 1024px) {
  .book-hero { grid-template-columns: 1fr; gap: 3rem; padding: 8rem 2.5rem 4rem; }
  .book-hero-photo { aspect-ratio: 16/9; }
  .book-options, .investment-section, .payment-section, .book-cancel, .book-cta { padding: 4rem 2.5rem; }
  .discovery-card, .ihm-card { grid-template-columns: 1fr; gap: 1.5rem; }
  .cards-two, .cards-two-bundles { grid-template-columns: 1fr; }
  .cancel-tiers { grid-template-columns: 1fr; }
  .investment-section, .payment-section { grid-template-columns: 1fr; gap: 2rem; }
}
</style>

<!-- HERO -->
<section class="book-hero">
  <div class="book-hero-text reveal">
    <p class="eyebrow">Book a consultation</p>
    <h1>Start your <em>healing journey</em></h1>
    <p>{d.heroDesc}</p>
  </div>
  <div class="reveal reveal-delay-1">
    {d.heroPhoto && d.heroPhoto !== '/images/sara-consultation.jpg' && (
      <div class="book-hero-photo">
        <img src={d.heroPhoto} alt="Sara Lemaitre" loading="eager" />
      </div>
    )}
  </div>
</section>

<!-- CARDS -->
<section class="book-options">
  <div class="book-options-intro reveal">
    <h2>Choose your consultation</h2>
    <p>Every consultation is confirmed after a brief review to ensure I can offer the right support. You will hear back within 48 hours.</p>
  </div>

  <p class="section-label">Free consultation</p>
  <div class="discovery-card reveal">
    <div class="discovery-price">Free</div>
    <div>
      <p class="discovery-title">{d.discoveryTitle}</p>
      <p class="discovery-tag">{d.discoveryTag}</p>
      <p class="discovery-desc">{d.discoveryDesc}</p>
    </div>
    <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="discovery-cta">Book free call</a>
  </div>

  <p class="section-label">Individual sessions</p>
  <div class="cards-two">
    <div class="pcard reveal">
      <div set:html={petalMark}></div>
      <p class="pcard-tag">{d.initialTag}</p>
      <p class="pcard-name">{d.initialTitle}</p>
      <p class="pcard-price">£{d.initialPrice}</p>
      <p class="pcard-sub">~5 hrs total work</p>
      <div class="pcard-divider"></div>
      <ul class="pcard-includes">
        {d.initialIncludes.map(i => <li>{i}</li>)}
      </ul>
      <p class="pcard-sliding">Sliding scale: £{d.initialSlidingScale}</p>
      <a href={'mailto:' + s.email + '?subject=Initial consultation request'} class="pcard-cta">Request consultation</a>
    </div>
    <div class="pcard reveal reveal-delay-1">
      <div set:html={petalMark}></div>
      <p class="pcard-tag">{d.followupTag}</p>
      <p class="pcard-name">{d.followupTitle}</p>
      <p class="pcard-price">£{d.followupPrice}</p>
      <p class="pcard-sub">~2.5-3 hrs total work</p>
      <div class="pcard-divider"></div>
      <ul class="pcard-includes">
        {d.followupIncludes.map(i => <li>{i}</li>)}
      </ul>
      <a href={'mailto:' + s.email + '?subject=Follow-up consultation request'} class="pcard-cta">Book follow-up</a>
    </div>
  </div>

  <p class="section-label">Bundles</p>
  <div class="cards-two-bundles">
    <div class="pcard pcard-bundle featured reveal">
      <p class="recommended-badge">Most recommended</p>
      <div set:html={petalMarkSage}></div>
      <p class="pcard-tag">{d.bundleTag}</p>
      <p class="pcard-name">{d.bundleTitle}</p>
      <p class="pcard-price">£{d.bundlePrice}</p>
      <p class="pcard-sub">Therapeutic journey 3–4 months</p>
      <div class="pcard-divider"></div>
      <ul class="pcard-includes">
        {d.bundleIncludes.map(i => <li>{i}</li>)}
      </ul>
      <p class="pcard-sliding">Sliding scale: £{d.bundleSlidingScale}</p>
      <a href={'mailto:' + s.email + '?subject=Bundle consultation request'} class="pcard-cta">Request bundle</a>
    </div>
    <div class="pcard pcard-bundle reveal reveal-delay-1">
      <div set:html={petalMark}></div>
      <p class="pcard-tag">{d.followupBundleTag}</p>
      <p class="pcard-name">{d.followupBundleTitle}</p>
      <p class="pcard-price">£{d.followupBundlePrice}</p>
      <p class="pcard-sub">Therapeutic journey 4–6 months</p>
      <div class="pcard-divider"></div>
      <ul class="pcard-includes">
        {d.followupBundleIncludes.map(i => <li>{i}</li>)}
      </ul>
      <a href={'mailto:' + s.email + '?subject=Follow-up bundle request'} class="pcard-cta">Request bundle</a>
    </div>
  </div>
  <p class="bundle-note">{d.bundleNote}</p>

  <p class="section-label" style="margin-top:3rem;">Bodywork</p>
  <div class="ihm-card reveal" id="ihm">
    <div class="ihm-price">£{d.ihmPrice}</div>
    <div>
      <p class="ihm-title">{d.ihmTitle}</p>
      <p class="ihm-tag">{d.ihmTag}</p>
      <p class="ihm-desc">A deeply relaxing Ayurvedic treatment working on the back, neck, shoulders, scalp and face. Resets the nervous system in a way that talk alone cannot. Standalone or combined with a herbal consultation.</p>
    </div>
    <a href={s.calendlyIhm || ('mailto:' + s.email + '?subject=Indian Head Massage booking')} class="ihm-cta">Book a massage</a>
  </div>
</section>

<!-- INVESTMENT & COMMITMENT -->
<section class="investment-section reveal">
  <div>
    <h2>Investment in your health</h2>
    {d.pricingNote.split('\n\n').map(p => <p>{p}</p>)}
  </div>
  <div class="commitment-box">
    <h2>{d.commitmentTitle}</h2>
    <p>{d.commitment1}</p>
    <p>{d.commitment2}</p>
  </div>
</section>

<!-- PAYMENT -->
<section class="payment-section reveal">
  <div>
    <h2>Payment by bank transfer</h2>
    <p>I accept payment by UK bank transfer — straightforward, secure, and fee-free for both of us.</p>
    <ol class="payment-steps">
      <li>Book your appointment using the options above.</li>
      <li>You will receive a confirmation email with bank transfer details.</li>
      <li>Transfer the consultation fee within 24 hours of booking.</li>
      <li>Your appointment is confirmed once payment is received.</li>
    </ol>
  </div>
  <div>
    <div class="bank-box">
      <h3>Good to know</h3>
      <ul class="good-to-know">
        <li>Bank transfer is completely free — no processing fees for you or for me.</li>
        <li>Transfers typically clear within a few hours for the same bank, or by the next working day.</li>
        <li>Please use your name and appointment date as the payment reference.</li>
        <li>If you have any difficulty with bank transfer, get in touch and we can find an alternative.</li>
      </ul>
    </div>
  </div>
</section>

<!-- CANCELLATION -->
<section class="book-cancel reveal">
  <h2>Cancellation policy</h2>
  <div class="cancel-tiers">
    {d.cancellationTiers.map(tier => (
      <div class="cancel-tier">
        <h3>{tier.title}</h3>
        <p>{tier.policy}</p>
      </div>
    ))}
  </div>
  <p class="cancel-note-text">{d.cancellationNote}</p>
</section>

<!-- CTA -->
<section class="book-cta">
  <h2 class="reveal">{d.finalCtaTitle}</h2>
  <p class="reveal">{d.finalCtaDesc}</p>
  <a href={s.calendlyDiscovery} target="_blank" rel="noopener" class="book-cta-btn reveal">Book your free discovery call</a>
</section>
